@if (Count > 0)
{
    <div class="ox-bulk" role="toolbar" aria-label="Selection">
        <span class="ox-bulk-count">@Count selected</span>
        @ChildContent
        <OxIconButton Icon="close" Label="Clear selection" OnClick="@(() => OnClear.InvokeAsync())" />
    </div>
}

@code {
    /// <summary>The actions for the selected rows, in place of the page actions while at least one row is selected.</summary>
    [Parameter] public int Count { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

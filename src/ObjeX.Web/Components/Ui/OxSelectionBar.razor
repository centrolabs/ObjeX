@if (Count > 0)
{
    <div class="ox-bulk" role="toolbar" aria-label="Selection">
        <b>@Count selected</b>
        @ChildContent
        <span class="ox-bulk-grow"></span>
        <OxIconButton Icon="close" Label="Clear selection" OnClick="@(() => OnClear.InvokeAsync())" />
    </div>
}

@code {
    /// <summary>The bar exists only while at least one row is selected.</summary>
    [Parameter] public int Count { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

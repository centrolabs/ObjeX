@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="ox-dropzone" @ref="_zone">
    <div class="ox-dropzone-overlay" aria-hidden="true"></div>
    @ChildContent
</div>

@code {
    ElementReference _zone;
    IJSObjectReference? _module;
    IJSObjectReference? _attached;

    /// <summary>Receives the files dropped anywhere on the zone, folders with their subfolders, through its add method.</summary>
    [Parameter] public IJSObjectReference? Sink { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Sink is null || ReferenceEquals(Sink, _attached)) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ObjeX.Web/Components/Ui/OxDropZone.razor.js");
        await _module.InvokeVoidAsync("initDropZone", _zone, Sink);
        _attached = Sink;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}

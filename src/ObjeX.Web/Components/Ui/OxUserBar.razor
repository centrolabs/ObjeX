<div class="ox-user">
    <OxSideItem Href="@ProfileHref" Label="@Name" RailTooltip="@($"{Name} · Profile")">
        <Leading><OxAvatar Name="@Name" /></Leading>
    </OxSideItem>
    @ChildContent
    <OxSideItem Label="Sign out" OnClick="@(() => OnSignOut.InvokeAsync())">
        <Leading><OxIcon Name="logout" /></Leading>
    </OxSideItem>
</div>
@if (Version is not null)
{
    <div class="ox-user-version">@Version</div>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string ProfileHref { get; set; } = "/profile";
    [Parameter] public string? Version { get; set; }
    /// <summary><see cref="OxSideItem"/> rows between the profile and Sign out, for example the theme switch.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }
}

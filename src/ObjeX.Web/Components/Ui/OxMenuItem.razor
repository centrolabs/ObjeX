@if (Href is null)
{
    <button type="button" role="menuitem" class="@Css" disabled="@Disabled" @onclick="Click">
        @if (Icon is not null) { <OxIcon Name="@Icon" /> }
        @ChildContent
    </button>
}
else
{
    <a role="menuitem" class="@Css" href="@Href" download="@Download" @onclick="Click">
        @if (Icon is not null) { <OxIcon Name="@Icon" /> }
        @ChildContent
    </a>
}

@code {
    [CascadingParameter] OxMenuButton? Menu { get; set; }

    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Download { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string Css => Danger ? "ox-menu-item is-danger" : "ox-menu-item";

    async Task Click()
    {
        if (Menu is not null) await Menu.CloseAsync();
        await OnClick.InvokeAsync();
    }
}

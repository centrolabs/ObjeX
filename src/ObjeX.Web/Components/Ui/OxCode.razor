<div class="ox-code @(Block ? "ox-code--block" : null)">
    @if (Block)
    {
        <pre>@Text</pre>
    }
    else
    {
        <code>@Text</code>
    }
    @if (Copyable)
    {
        <OxCopyButton Text="@Text" />
    }
</div>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    /// <summary>Several lines, kept as written, for a command or a config snippet.</summary>
    [Parameter] public bool Block { get; set; }
    [Parameter] public bool Copyable { get; set; }
}

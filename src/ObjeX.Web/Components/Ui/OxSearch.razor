<label class="ox-search">
    <OxIcon Name="search" />
    <input type="text" value="@Value" placeholder="@Placeholder" aria-label="@Placeholder" title="@Title" autocomplete="off"
           @oninput="@(e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty))" @onkeydown="OnKeyDown" />
    @if (!string.IsNullOrEmpty(Value))
    {
        <button type="button" class="ox-search-clear" title="Clear search" aria-label="Clear search" @onclick="@(() => OnClear.InvokeAsync())">
            <OxIcon Name="close" Small="true" />
        </button>
    }
</label>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    /// <summary>Fires on every keystroke.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Fires on Escape and on the clear button.</summary>
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search";
    [Parameter] public string? Title { get; set; }

    Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? OnClear.InvokeAsync() : Task.CompletedTask;
}

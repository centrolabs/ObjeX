@if (Href is null)
{
    <button type="button" class="@Css" disabled="@Disabled" aria-label="@Label" aria-busy="@(Busy ? "true" : null)"
            data-ox-tooltip="@Label" data-ox-tooltip-placement="@OxTooltip.PlacementValue(TooltipPlacement)" @onclick="OnClick" @attributes="Attributes">
        <OxIcon Name="@Icon" Class="@(Busy ? "ox-icon--spin" : null)" />
    </button>
}
else
{
    <a href="@Href" class="@Css" aria-label="@Label" download="@Download"
       data-ox-tooltip="@Label" data-ox-tooltip-placement="@OxTooltip.PlacementValue(TooltipPlacement)" @attributes="Attributes">
        <OxIcon Name="@Icon" />
    </a>
}

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    /// <summary>Accessible name and tooltip. An icon button has no visible text, so this is required.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public OxPlacement TooltipPlacement { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Spins the icon while the action runs. The button keeps its look; the page ignores repeated clicks.</summary>
    [Parameter] public bool Busy { get; set; }
    /// <summary>Keeps the hover look while the button's menu is open.</summary>
    [Parameter] public bool Active { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Download { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    string Css => Active ? "ox-icon-btn is-active" : "ox-icon-btn";
}

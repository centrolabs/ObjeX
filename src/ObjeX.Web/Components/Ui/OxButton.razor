@if (Href is null)
{
    <button type="@Type" class="@Css" disabled="@Disabled" title="@Title" @onclick="OnClick" @attributes="Attributes">
        @if (Icon is not null) { <OxIcon Name="@Icon" /> }
        @ChildContent
    </button>
}
else
{
    <a href="@Href" class="@Css" title="@Title" download="@Download" @attributes="Attributes">
        @if (Icon is not null) { <OxIcon Name="@Icon" /> }
        @ChildContent
    </a>
}

@code {
    [Parameter] public OxButtonVariant Variant { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>"button" or "submit". Ignored when <see cref="Href"/> is set.</summary>
    [Parameter] public string Type { get; set; } = "button";
    /// <summary>Renders a link that looks like a button, for downloads and plain navigation.</summary>
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Download { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Block { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    string Css => "ox-btn" + Variant switch
    {
        OxButtonVariant.Primary => " ox-btn--primary",
        OxButtonVariant.Danger => " ox-btn--danger",
        _ => string.Empty
    } + (Block ? " ox-btn--block" : string.Empty);
}

@* @key gives every file a fresh element: a <video> keeps playing its old <source> when only the src changes.
   The arrow keys seek in video and audio, so they stay there instead of reaching a dialog that pages with them. *@
<div class="ox-preview">
    @switch (Kind)
    {
        case OxPreviewKind.Image:
            <img @key="Url" src="@Url" alt="@Alt" />
            break;
        case OxPreviewKind.Video:
            <video @key="Url" controls @onkeydown:stopPropagation="true">
                <source src="@Url" type="@ContentType" />
            </video>
            break;
        case OxPreviewKind.Audio:
            <audio @key="Url" controls @onkeydown:stopPropagation="true">
                <source src="@Url" type="@ContentType" />
            </audio>
            break;
        case OxPreviewKind.Pdf:
            <iframe @key="Url" src="@(Url + "#pagemode=none&toolbar=0")" title="@Alt"></iframe>
            break;
        case OxPreviewKind.Text:
            <pre>@Text</pre>
            break;
    }
</div>

@code {
    [Parameter] public OxPreviewKind Kind { get; set; }
    [Parameter] public string? Url { get; set; }
    [Parameter] public string? ContentType { get; set; }
    [Parameter] public string? Alt { get; set; }
    /// <summary>The content for <see cref="OxPreviewKind.Text"/>; the caller loads it.</summary>
    [Parameter] public string? Text { get; set; }
}

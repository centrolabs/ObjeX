@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<ObjeX.Infrastructure.Data.ObjeXDbContext> DbFactory
@inject UiPreferences Preferences
@using Microsoft.EntityFrameworkCore

<AuthorizeView>
    <Authorized>
        <OxShell Collapsed="@Preferences.SidebarCollapsed" CollapsedChanged="@Preferences.SetSidebarCollapsedAsync"
                 Width="@Preferences.SidebarWidth" WidthChanged="@Preferences.SetSidebarWidthAsync"
                 MinWidth="@UiPreferences.SidebarMinWidth" MaxWidth="@UiPreferences.SidebarMaxWidth">
            <Nav><NavMenu /></Nav>
            <SideFooter><SidebarFooter /></SideFooter>
            <ChildContent>@Body</ChildContent>
        </OxShell>

        <RadzenComponents />
        <OxTooltipHost />
        <CommandPalette />
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Preferences.Changed += OnPreferencesChanged;
    }

    void OnPreferencesChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await CheckDeactivatedAsync();
    }

    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = CheckDeactivatedAsync();

    async Task CheckDeactivatedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!auth.User.Identity?.IsAuthenticated == true) return;

        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        // Its own short context: this runs on every navigation, interleaved with the new page's own queries.
        await using var db = await DbFactory.CreateDbContextAsync();
        var user = await db.Users.Where(u => u.Id == userId)
            .Select(u => new { u.IsDeactivated, u.MustChangePassword })
            .FirstOrDefaultAsync();
        if (user?.IsDeactivated == true)
            Navigation.NavigateTo("/account/logout", forceLoad: true);
        else if (user?.MustChangePassword == true && !Navigation.Uri.Contains("/change-password"))
            Navigation.NavigateTo("/change-password", forceLoad: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Preferences.Changed -= OnPreferencesChanged;
    }
}

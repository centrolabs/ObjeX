@inject AuthenticationStateProvider AuthStateProvider

<OxNavItem Href="/" Icon="dashboard">Dashboard</OxNavItem>
<OxNavItem Href="/buckets" Icon="inventory_2">Buckets</OxNavItem>
@if (_isAdmin)
{
    <OxNavItem Href="/audit" Icon="history">Audit Log</OxNavItem>
}
@if (_isAdmin || _isManager)
{
    <OxNavItem Href="/users" Icon="group">Users</OxNavItem>
}
@if (_isAdmin)
{
    <OxNavItem Href="/hangfire" Icon="schedule" FullLoad="true">Jobs</OxNavItem>
}
<OxNavItem Href="/settings" Icon="settings">Settings</OxNavItem>

@code {
    bool _isAdmin;
    bool _isManager;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = auth.User.IsInRole("Admin");
        _isManager = auth.User.IsInRole("Manager");
    }
}

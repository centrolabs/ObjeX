@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject CommandPaletteState Palette

<OxSideItem Label="Search" Hint="@Palette.Shortcut" RailTooltip="@($"Search ({Palette.Shortcut})")" OnClick="@Palette.Open">
    <Leading><OxIcon Name="search" /></Leading>
</OxSideItem>

<OxNavItem Href="/" Icon="dashboard" Label="Dashboard" />
<OxNavItem Href="/buckets" Icon="inventory_2" Label="Buckets" />
@if (_isAdmin)
{
    <OxNavItem Href="/audit" Icon="history" Label="Audit Log" />
}
@if (_isAdmin || _isManager)
{
    <OxNavItem Href="/users" Icon="group" Label="Users" />
}
@if (_isAdmin)
{
    <OxNavItem Href="/jobs" Icon="schedule" Label="Jobs" />
}
<OxNavItem Href="/settings" Icon="settings" Label="Settings" />

@code {
    bool _isAdmin;
    bool _isManager;

    // The shortcut is spelled for the platform once the browser has said which one it is.
    protected override void OnInitialized() => Palette.Changed += OnPaletteChanged;

    void OnPaletteChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Palette.Changed -= OnPaletteChanged;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = auth.User.IsInRole("Admin");
        _isManager = auth.User.IsInRole("Manager");
    }
}

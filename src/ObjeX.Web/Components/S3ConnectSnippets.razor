<OxTabs Captions="@Captions" @bind-Active="_active">
    <OxCode Text="@Snippets[_active].Text" Block="true" Copyable="true" />
</OxTabs>

@code {
    [Parameter] public string Endpoint { get; set; } = string.Empty;
    [Parameter] public string AccessKeyId { get; set; } = string.Empty;
    [Parameter] public string? SecretAccessKey { get; set; }

    int _active;

    record Snippet(string Caption, string Text);

    static readonly IReadOnlyList<string> Captions = ["AWS CLI", "rclone", "Environment"];

    Snippet[] Snippets =>
    [
        new(Captions[0], S3ClientSnippets.AwsCli(Endpoint, AccessKeyId, SecretAccessKey)),
        new(Captions[1], S3ClientSnippets.Rclone(Endpoint, AccessKeyId, SecretAccessKey)),
        new(Captions[2], S3ClientSnippets.Env(Endpoint, AccessKeyId, SecretAccessKey)),
    ];
}

@page "/jobs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@implements IDisposable
@using ObjeX.Core.Interfaces
@using ObjeX.Web.Components.Dialogs
@inject IJobMonitor Monitor
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject BrowserTimeZone Tz

<PageTitle>Jobs — ObjeX</PageTitle>

<OxPageHeader Title="Jobs">
    @* target leaves the circuit: /hangfire is no Blazor page. *@
    <OxButton Icon="open_in_new" Href="/hangfire" target="_top">Hangfire dashboard</OxButton>
</OxPageHeader>

<OxCard Title="Recurring jobs" Flush="true">
    <RadzenDataGrid class="@OxSizes.RoomyGridClass" Data="_jobs" TItem="RecurringJobStatus" AllowSorting="false" AllowAlternatingRows="false" EmptyText="No recurring jobs.">
        <Columns>
            <RadzenDataGridColumn TItem="RecurringJobStatus" Property="Name" Title="Job" Width="@OxSizes.NameColumn">
                <Template Context="job">
                    <OxStack Gap="1">
                        <OxText Truncate="true"><strong>@job.Name</strong></OxText>
                        <OxText Variant="OxTextVariant.Small" Truncate="true" title="@($"{job.Cron} (UTC)")">@(CronText.Describe(job.Cron, job.NextRun, Tz) ?? $"{job.Cron} (UTC)")</OxText>
                    </OxStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RecurringJobStatus" Property="NextRun" Title="Next run" Width="@OxSizes.DateColumn" CssClass="ox-col-muted">
                <Template Context="job">@Tz.Format(job.NextRun)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RecurringJobStatus" Property="LastRun" Title="Last run" Width="@OxSizes.DateColumn">
                <Template Context="job">
                    @if (job.LastJob is { } last)
                    {
                        <OxStack Gap="1" Align="OxAlign.Start">
                            <OxBadge Tone="@ToneOf(last.State)">@LabelOf(last.State)</OxBadge>
                            <OxText Variant="OxTextVariant.Small">@Tz.Format(job.LastRun)</OxText>
                        </OxStack>
                    }
                    else
                    {
                        <OxText Variant="OxTextVariant.Muted">@(job.LastRun is null ? "Never run" : Tz.Format(job.LastRun))</OxText>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RecurringJobStatus" Title="Last result" CssClass="ox-col-muted">
                <Template Context="job">
                    @if (job.LastJob is { } last)
                    {
                        <OxLink Href="@JobRunText.DetailsUrl(last.Id)" title="@(last.Error ?? last.Result ?? "Details")">
                            <OxText Truncate="true" Tone="@(last.Error is null ? OxTone.Default : OxTone.Danger)">@(last.Error ?? last.Result ?? "Details")</OxText>
                        </OxLink>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RecurringJobStatus" Title="" Width="@OxSizes.ButtonColumn" CssClass="ox-col-actions">
                <Template Context="job">
                    <OxButton Icon="play_arrow" Disabled="@IsActive(job.LastJob)" OnClick="@(() => RunNow(job))">Run now</OxButton>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</OxCard>

<OxCard Title="Recent runs" Flush="true">
    @if (_runs.Count == 0)
    {
        <OxEmptyState Icon="schedule" Title="No runs yet">Runs appear here once a job has run on its schedule or through Run now.</OxEmptyState>
    }
    else
    {
        <RadzenDataGrid Data="_runs" TItem="JobRun" AllowSorting="false" AllowAlternatingRows="false" AllowPaging="true" PageSize="20">
            <Columns>
                <RadzenDataGridColumn TItem="JobRun" Property="StartedAt" Title="Started" Width="@OxSizes.TimestampColumn" CssClass="ox-col-muted">
                    <Template Context="run">@(run.StartedAt is { } started ? Tz.FormatSeconds(started) : "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="JobRun" Property="Name" Title="Job" Width="@OxSizes.NameColumn">
                    <Template Context="run"><OxLink Href="@JobRunText.DetailsUrl(run.Id)">@run.Name</OxLink></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="JobRun" Title="Status" Width="@OxSizes.NumberColumn">
                    <Template Context="run"><OxBadge Tone="@ToneOf(run.State)">@LabelOf(run.State)</OxBadge></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="JobRun" Title="Duration" Width="@OxSizes.NumberColumn" TextAlign="TextAlign.End" CssClass="ox-col-muted">
                    <Template Context="run">@(run.Duration is { } duration ? FormatDuration(duration) : "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="JobRun" Title="Result" CssClass="ox-col-muted">
                    <Template Context="run">
                        <OxText Truncate="true" Tone="@(run.Error is null ? OxTone.Default : OxTone.Danger)" title="@(run.Error ?? run.Result)">@(run.Error ?? run.Result)</OxText>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="JobRun" Title="" Width="@OxSizes.ActionsColumn" CssClass="ox-col-actions">
                    <Template Context="run">
                        <OxRowActions>
                            @if (JobRunText.CanRetry(run.State))
                            {
                                <OxIconButton Icon="replay" Label="Retry" OnClick="@(() => Retry(run))" />
                            }
                            <OxMenuButton Label="@($"More actions for run {run.Id}")">
                                <OxMenuItem Icon="info" Href="@JobRunText.DetailsUrl(run.Id)">Details</OxMenuItem>
                                @if (JobRunText.CanDelete(run.State))
                                {
                                    <OxMenuDivider />
                                    <OxMenuItem Icon="delete" Danger="true" OnClick="@(() => Delete(run))">Delete</OxMenuItem>
                                }
                            </OxMenuButton>
                        </OxRowActions>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</OxCard>

@code {
    const int HistorySize = 50;
    static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(3);

    IReadOnlyList<RecurringJobStatus> _jobs = [];
    IReadOnlyList<JobRun> _runs = [];
    readonly CancellationTokenSource _disposed = new();
    bool _polling;

    protected override void OnInitialized() => Load();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _ = PollWhileActiveAsync();
    }

    void Load()
    {
        _jobs = Monitor.GetRecurringJobs();
        _runs = Monitor.GetRecentRuns(HistorySize);
    }

    async Task RunNow(RecurringJobStatus job)
    {
        if (!await ConfirmDialog.AskAsync(DialogService, "Run now", $"Run \"{job.Name}\" now? Its schedule stays as it is.", "Run now")) return;

        Monitor.Trigger(job.Id);
        Load();
        NotificationService.Notify(NotificationSeverity.Success, "Queued", $"\"{job.Name}\" is queued.");
        _ = PollWhileActiveAsync();
    }

    async Task Retry(JobRun run)
    {
        if (!Monitor.Retry(run.Id))
            NotificationService.Notify(NotificationSeverity.Error, "Retry failed", "The run no longer exists.");
        else
            NotificationService.Notify(NotificationSeverity.Success, "Queued", $"\"{run.Name}\" runs again.");
        Load();
        await PollWhileActiveAsync();
    }

    async Task Delete(JobRun run)
    {
        if (!await ConfirmDialog.AskAsync(DialogService, "Delete run", $"Delete run #{run.Id} of \"{run.Name}\"? A queued or retrying run will not run.", "Delete", danger: true)) return;

        if (!Monitor.Delete(run.Id))
            NotificationService.Notify(NotificationSeverity.Error, "Delete failed", "The run no longer exists.");
        Load();
    }

    // Reloads while a run is queued or running, so its result shows up without a page reload.
    async Task PollWhileActiveAsync()
    {
        if (_polling || !AnyActive)
            return;

        _polling = true;
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(_disposed.Token))
            {
                await InvokeAsync(() =>
                {
                    Load();
                    StateHasChanged();
                });
                if (!AnyActive)
                    break;
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _polling = false;
        }
    }

    bool AnyActive => _jobs.Any(j => IsActive(j.LastJob)) || _runs.Any(r => IsActive(r));

    static bool IsActive(JobRun? run) => JobRunText.IsActive(run?.State);

    static OxTone ToneOf(JobRunState state) => JobRunText.ToneOf(state);

    static string LabelOf(JobRunState state) => JobRunText.LabelOf(state);

    static string FormatDuration(TimeSpan d) => JobRunText.FormatDuration(d);

    public void Dispose() => _disposed.Cancel();
}

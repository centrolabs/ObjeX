@page "/buckets"
@using ObjeX.Core.Interfaces
@using ObjeX.Core.Models
@using ObjeX.Infrastructure.Data
@using ObjeX.Web.Components.Dialogs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ObjeX.Infrastructure.Options
@inject IMetadataService MetadataService
@inject IObjectStorageService StorageService
@inject ILogger<Buckets> Logger
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject IOptions<DefaultAdminOptions> DefaultAdmin
@inject IDbContextFactory<ObjeXDbContext> DbFactory

<PageTitle>Buckets — ObjeX</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenText TextStyle="TextStyle.H4" Style="margin:0">Buckets</RadzenText>
            @if (_searchApplied)
            {
                <RadzenText TextStyle="TextStyle.Caption" Style="margin:0 0 0 0.75rem;color:var(--rz-text-secondary-color)">
                    @HeaderCaption
                </RadzenText>
            }
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            @if (_buckets.Count > 0)
            {
                <input class="rz-textbox" style="width:220px" type="text" placeholder="Search all buckets" autocomplete="off"
                       value="@_searchTerm" @oninput="OnSearchInput" @onkeydown="OnSearchKeyDown" />
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                              Click="@ClearSearch" title="Clear search"
                              style="@(_searchTerm.Length > 0 ? "" : "display:none")" />
            }
            <RadzenButton Text="Create Bucket" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@OnCreateBucket" />
        </RadzenStack>
    </RadzenStack>

    <div style="overflow-x:auto">
    @if (_searchApplied)
    {
        <RadzenDataGrid Data="@_results" TItem="BlobObject" AllowSorting="true" EmptyText="No matches.">
            <Columns>
                <RadzenDataGridColumn TItem="BlobObject" Property="BucketName" Title="Bucket" Width="180px">
                    <Template Context="obj">
                        <a href="/buckets/@Uri.EscapeDataString(obj.BucketName)" style="color:var(--rz-primary);text-decoration:none">@obj.BucketName</a>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BlobObject" Property="Key" Title="Key">
                    <Template Context="obj">
                        <a href="@FolderUrl(obj)" style="color:var(--rz-primary);text-decoration:none">@obj.Key</a>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BlobObject" Property="Size" Title="Size" Width="120px">
                    <Template Context="obj">@FileHelper.FormatBytes(obj.Size)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BlobObject" Property="UpdatedAt" Title="Modified" Width="160px">
                    <Template Context="obj">@obj.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BlobObject" Title="" Width="60px" Sortable="false">
                    <Template Context="obj">
                        <div style="display:flex;align-items:center;justify-content:flex-end">
                            <a href="@FileHelper.ObjectUrl(obj.BucketName, obj.Key, download: true)" download="@Path.GetFileName(obj.Key)" target="_blank" style="display:flex">
                                <RadzenButton Icon="download" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" />
                            </a>
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
    else
    {
    <RadzenDataGrid Data="@_buckets" TItem="Bucket" AllowSorting="true" EmptyText="No buckets yet.">
        <Columns>
            <RadzenDataGridColumn TItem="Bucket" Property="Name" Title="Name">
                <Template Context="bucket">
                    <a href="/buckets/@bucket.Name" style="color:var(--rz-primary);text-decoration:none">@bucket.Name</a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Bucket" Property="ObjectCount" Title="Objects" />
            <RadzenDataGridColumn TItem="Bucket" Property="TotalSize" Title="Size" Sortable="true">
                <Template Context="bucket">@FileHelper.FormatBytes(bucket.TotalSize)</Template>
            </RadzenDataGridColumn>
            @if (_isPrivileged)
            {
                <RadzenDataGridColumn TItem="Bucket" Property="Owner.UserName" Title="Owner" Width="120px">
                    <Template Context="bucket">
                        @if (bucket.Owner?.UserName == _adminUsername)
                        {
                            <RadzenBadge Text="Admin" BadgeStyle="BadgeStyle.Light" Shade="Shade.Default" />
                        }
                        else
                        {
                            @(bucket.Owner?.UserName ?? _adminUsername)
                        }
                    </Template>
                </RadzenDataGridColumn>
            }
            <RadzenDataGridColumn TItem="Bucket" Property="CreatedAt" Title="Created" FormatString="{0:yyyy-MM-dd HH:mm}" />
            <RadzenDataGridColumn TItem="Bucket" Title="" Width="@(_isAdmin ? "100px" : "60px")" Sortable="false">
                <Template Context="bucket">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0" JustifyContent="JustifyContent.End">
                        @if (_isAdmin)
                        {
                            <RadzenButton Icon="manage_accounts" ButtonStyle="ButtonStyle.Info" Variant="Variant.Text"
                                          title="Change owner" Click="@(() => OnChangeOwner(bucket))" />
                        }
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                      Click="@(() => OnDeleteBucket(bucket))" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    }
    </div>
</RadzenStack>

@code {
    List<Bucket> _buckets = [];
    List<BlobObject> _results = [];
    string _currentUserId = string.Empty;
    bool _isPrivileged;
    bool _isAdmin;
    string _adminUsername = "admin";
    string _searchTerm = string.Empty;
    bool _searchApplied;
    bool _searchLimitHit;
    CancellationTokenSource _searchCts = new();

    const int SearchLimit = 500;
    const int SearchDebounceMs = 300;

    string HeaderCaption =>
        _searchLimitHit
            ? $"{_results.Count:N0} results · first {SearchLimit} shown"
            : $"{_results.Count:N0} results";

    /// <summary>Keys may contain URL syntax, so each segment is encoded while the slashes stay readable.</summary>
    static string FolderUrl(BlobObject obj)
    {
        var url = $"/buckets/{Uri.EscapeDataString(obj.BucketName)}";
        var cut = obj.Key.LastIndexOf('/');
        if (cut < 0) return url;

        var folder = obj.Key[..(cut + 1)];
        return $"{url}?prefix={string.Join("/", folder.Split('/').Select(Uri.EscapeDataString))}";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _isPrivileged = auth.User.IsInRole("Admin") || auth.User.IsInRole("Manager");
        _isAdmin = auth.User.IsInRole("Admin");
        _adminUsername = DefaultAdmin.Value.Username;
        await LoadBuckets();
    }

    async Task LoadBuckets()
    {
        var result = await MetadataService.ListBucketsAsync(_isPrivileged ? null : _currentUserId);
        _buckets = result.ToList();

        // The search box is gone once the last bucket is deleted, so a term left over would be unclearable.
        if (_buckets.Count == 0)
            ClearSearch();
    }

    async Task RunSearch(CancellationToken ctk)
    {
        // One row over the limit tells the caption whether the result set was cut off.
        var hits = await MetadataService.SearchAllObjectsAsync(_isPrivileged ? null : _currentUserId, _searchTerm, SearchLimit + 1, ctk);
        _searchLimitHit = hits.Count > SearchLimit;
        _results = hits.Take(SearchLimit).ToList();
        _searchApplied = true;
    }

    async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        // Blazor serialises handlers on its dispatcher, so replacing the source cannot race with the awaiting keystroke.
        _searchCts.Cancel();
        _searchCts = new CancellationTokenSource();
        var ctk = _searchCts.Token;

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            ShowBucketGrid();
            return;
        }

        try
        {
            await Task.Delay(SearchDebounceMs, ctk);
            await RunSearch(ctk);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ClearSearch();
    }

    void ClearSearch()
    {
        _searchTerm = string.Empty;
        ShowBucketGrid();
    }

    // Cancels the pending debounce too, so a stale keystroke cannot re-apply the search afterwards.
    void ShowBucketGrid()
    {
        _searchCts.Cancel();
        _searchCts = new CancellationTokenSource();
        _searchApplied = false;
        _searchLimitHit = false;
        _results = [];
    }

    async Task OnCreateBucket()
    {
        var name = await DialogService.OpenAsync<CreateBucketDialog>("Create Bucket");
        if (name is null) return;

        try
        {
            await MetadataService.CreateBucketAsync(new Bucket { Name = name, OwnerId = _currentUserId }, _currentUserId);
            await LoadBuckets();
            NotificationService.Notify(NotificationSeverity.Success, "Bucket created", name);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to create bucket", ex.Message);
        }
    }

    async Task OnDeleteBucket(Bucket bucket)
    {
        var confirmed = await DialogService.Confirm(
            $"Delete \"{bucket.Name}\"? This will permanently remove all {bucket.ObjectCount} object(s) inside.",
            "Delete Bucket",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel", CloseDialogOnOverlayClick = true });

        if (confirmed != true) return;

        try
        {
            await MetadataService.DeleteBucketAsync(bucket.Name, _currentUserId, _isPrivileged, _currentUserId);
            try
            {
                await StorageService.DeleteBucketAsync(bucket.Name);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Blob folder of bucket {Bucket} could not be deleted and is left for the orphan cleanup job", bucket.Name);
            }
            await LoadBuckets();
            NotificationService.Notify(NotificationSeverity.Success, "Bucket deleted", bucket.Name);
        }
        catch (UnauthorizedAccessException)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Forbidden", "You do not own this bucket.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to delete bucket", ex.Message);
        }
    }

    async Task OnChangeOwner(Bucket bucket)
    {
        var result = await DialogService.OpenAsync<ChangeOwnerDialog>("Change Owner",
            new Dictionary<string, object?> { { "Bucket", bucket } },
            new DialogOptions { CloseDialogOnOverlayClick = true, ShowClose = true });

        if (result is not ChangeOwnerDialog.Result r) return;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.Buckets
                .Where(b => b.Id == bucket.Id)
                .ExecuteUpdateAsync(s => s.SetProperty(b => b.OwnerId, r.UserId));

            db.AuditEntries.Add(new AuditEntry { UserId = _currentUserId, Action = "ChangeOwner", BucketName = bucket.Name, Details = $"New owner: {r.UserName}" });
            await db.SaveChangesAsync();
        }

        await LoadBuckets();
        NotificationService.Notify(NotificationSeverity.Success, "Owner changed",
            $"\"{bucket.Name}\" is now owned by {r.UserName}.");
    }
}

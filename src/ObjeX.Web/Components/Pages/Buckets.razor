@page "/buckets"
@using ObjeX.Core.Interfaces
@using ObjeX.Core.Models
@using ObjeX.Infrastructure.Data
@using ObjeX.Web.Components.Dialogs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ObjeX.Infrastructure.Options
@inject IMetadataService MetadataService
@inject IObjectStorageService StorageService
@inject ILogger<Buckets> Logger
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject IOptions<DefaultAdminOptions> DefaultAdmin
@inject IDbContextFactory<ObjeXDbContext> DbFactory
@inject BrowserTimeZone Tz

<PageTitle>Buckets — ObjeX</PageTitle>

<OxPageHeader Title="Buckets" Meta="@(_searchApplied ? HeaderCaption : null)">
    @if (_buckets.Count > 0)
    {
        <OxSearch Value="@_searchTerm" ValueChanged="OnSearchInput" OnClear="ClearSearch" Placeholder="Search all buckets" Tooltip="* matches any text, ? one character" />
    }
    <OxIconButton Icon="refresh" Label="Refresh" OnClick="Refresh" Busy="@_refreshing" />
    <OxButton Variant="OxButtonVariant.Primary" Icon="add" OnClick="OnCreateBucket">New bucket</OxButton>
</OxPageHeader>

@if (_searchApplied)
{
    <RadzenDataGrid Data="@_results" TItem="BlobObject" AllowSorting="true" AllowAlternatingRows="false" EmptyText="No matches.">
        <Columns>
            <RadzenDataGridColumn TItem="BlobObject" Property="BucketName" Title="Bucket" Width="@OxSizes.TypeColumn">
                <Template Context="obj">
                    <OxFileName Kind="OxFileKind.Bucket" Href="@($"/buckets/{Uri.EscapeDataString(obj.BucketName)}")">@obj.BucketName</OxFileName>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BlobObject" Property="Key" Title="Key">
                <Template Context="obj">
                    <OxFileName Kind="@OxFileIcon.KindOf(obj.ContentType)" Href="@FolderUrl(obj)">@obj.Key</OxFileName>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BlobObject" Property="Size" Title="Size" Width="@OxSizes.SizeColumn" TextAlign="TextAlign.End">
                <Template Context="obj">@FileHelper.FormatBytes(obj.Size)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BlobObject" Property="UpdatedAt" Title="Modified" Width="@OxSizes.DateColumn" CssClass="ox-col-muted">
                <Template Context="obj"><OxTime Value="@obj.UpdatedAt" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BlobObject" Title="" Width="@OxSizes.MenuColumn" Sortable="false" CssClass="ox-col-actions">
                <Template Context="obj">
                    <OxRowActions>
                        <OxIconButton Icon="download" Label="Download" Href="@FileHelper.ObjectUrl(obj.BucketName, obj.Key, download: true)"
                                      Download="@Path.GetFileName(obj.Key)" target="_blank" />
                    </OxRowActions>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <RadzenDataGrid class="@OxSizes.WideGridClass" Data="@_buckets" TItem="Bucket" AllowSorting="true" AllowAlternatingRows="false" EmptyText="No buckets yet. Create one to store objects.">
        <Columns>
            <RadzenDataGridColumn TItem="Bucket" Property="Name" Title="Name">
                <Template Context="bucket">
                    <OxFileName Kind="OxFileKind.Bucket" Href="@($"/buckets/{bucket.Name}")">@bucket.Name</OxFileName>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Bucket" Property="ObjectCount" Title="Objects" Width="@OxSizes.NumberColumn" TextAlign="TextAlign.End">
                <Template Context="bucket">@bucket.ObjectCount.ToString("N0")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Bucket" Property="TotalSize" Title="Size" Width="@OxSizes.SizeColumn" TextAlign="TextAlign.End">
                <Template Context="bucket">@FileHelper.FormatBytes(bucket.TotalSize)</Template>
            </RadzenDataGridColumn>
            @if (_isPrivileged)
            {
                <RadzenDataGridColumn TItem="Bucket" Property="Owner.UserName" Title="Owner" Width="@OxSizes.TypeColumn" CssClass="ox-col-muted">
                    <Template Context="bucket">@(bucket.Owner?.UserName ?? _adminUsername)</Template>
                </RadzenDataGridColumn>
            }
            <RadzenDataGridColumn TItem="Bucket" Property="CreatedAt" Title="Created" Width="@OxSizes.DateColumn" CssClass="ox-col-muted">
                <Template Context="bucket"><OxTime Value="@bucket.CreatedAt" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Bucket" Property="UpdatedAt" Title="Modified" Width="@OxSizes.DateColumn" CssClass="ox-col-muted">
                <Template Context="bucket"><OxTime Value="@bucket.UpdatedAt" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Bucket" Title="" Width="@OxSizes.MenuColumn" Sortable="false" CssClass="ox-col-actions">
                <Template Context="bucket">
                    <OxRowActions>
                        <OxMenuButton Label="@($"More actions for {bucket.Name}")">
                            @if (_isAdmin)
                            {
                                <OxMenuItem Icon="manage_accounts" OnClick="@(() => OnChangeOwner(bucket))">Change owner</OxMenuItem>
                                <OxMenuDivider />
                            }
                            <OxMenuItem Icon="delete" Danger="true" OnClick="@(() => OnDeleteBucket(bucket))">Delete</OxMenuItem>
                        </OxMenuButton>
                    </OxRowActions>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    List<Bucket> _buckets = [];
    List<BlobObject> _results = [];
    string _currentUserId = string.Empty;
    bool _isPrivileged;
    bool _isAdmin;
    string _adminUsername = "admin";
    string _searchTerm = string.Empty;
    bool _searchApplied;
    bool _searchLimitHit;
    bool _refreshing;
    CancellationTokenSource _searchCts = new();

    const int SearchLimit = 500;
    const int SearchDebounceMs = 300;

    string HeaderCaption =>
        _searchLimitHit
            ? $"{_results.Count:N0} results · first {SearchLimit} shown"
            : $"{_results.Count:N0} results";

    /// <summary>Keys may contain URL syntax, so each segment is encoded while the slashes stay readable.</summary>
    static string FolderUrl(BlobObject obj)
    {
        var url = $"/buckets/{Uri.EscapeDataString(obj.BucketName)}";
        var cut = obj.Key.LastIndexOf('/');
        if (cut < 0) return url;

        var folder = obj.Key[..(cut + 1)];
        return $"{url}?prefix={string.Join("/", folder.Split('/').Select(Uri.EscapeDataString))}";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _isPrivileged = auth.User.IsInRole("Admin") || auth.User.IsInRole("Manager");
        _isAdmin = auth.User.IsInRole("Admin");
        _adminUsername = DefaultAdmin.Value.Username;
        await LoadBuckets();
    }

    async Task LoadBuckets()
    {
        var result = await MetadataService.ListBucketsAsync(_isPrivileged ? null : _currentUserId);
        _buckets = result.ToList();

        // The search box is gone once the last bucket is deleted, so a term left over would be unclearable.
        if (_buckets.Count == 0)
            ClearSearch();
    }

    // Buckets made through S3 or by another user appear only after a reload; a running search is repeated with them.
    async Task Refresh()
    {
        if (_refreshing) return;
        _refreshing = true;
        try
        {
            var feedback = Task.Delay(OxMotion.SpinTurn);
            await LoadBuckets();
            if (_searchApplied)
                await RunSearch(_searchCts.Token);
            await feedback;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Bucket list refresh failed");
            NotificationService.Notify(NotificationSeverity.Error, "Refresh failed", ex.Message);
        }
        finally
        {
            _refreshing = false;
        }
    }

    async Task RunSearch(CancellationToken ctk)
    {
        // One row over the limit tells the caption whether the result set was cut off.
        var hits = await MetadataService.SearchAllObjectsAsync(_isPrivileged ? null : _currentUserId, _searchTerm, SearchLimit + 1, ctk);
        _searchLimitHit = hits.Count > SearchLimit;
        _results = hits.Take(SearchLimit).ToList();
        _searchApplied = true;
    }

    async Task OnSearchInput(string value)
    {
        _searchTerm = value;
        // Blazor serialises handlers on its dispatcher, so replacing the source cannot race with the awaiting keystroke.
        _searchCts.Cancel();
        _searchCts = new CancellationTokenSource();
        var ctk = _searchCts.Token;

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            ShowBucketGrid();
            return;
        }

        try
        {
            await Task.Delay(SearchDebounceMs, ctk);
            await RunSearch(ctk);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    void ClearSearch()
    {
        _searchTerm = string.Empty;
        ShowBucketGrid();
    }

    // Cancels the pending debounce too, so a stale keystroke cannot re-apply the search afterwards.
    void ShowBucketGrid()
    {
        _searchCts.Cancel();
        _searchCts = new CancellationTokenSource();
        _searchApplied = false;
        _searchLimitHit = false;
        _results = [];
    }

    async Task OnCreateBucket()
    {
        var name = await DialogService.OpenAsync<CreateBucketDialog>("New bucket", options: new DialogOptions { Width = OxSizes.DialogSmall, CloseDialogOnOverlayClick = true });
        if (name is null) return;

        try
        {
            await MetadataService.CreateBucketAsync(new Bucket { Name = name, OwnerId = _currentUserId }, _currentUserId);
            await LoadBuckets();
            NotificationService.Notify(NotificationSeverity.Success, "Bucket created", name);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to create bucket", ex.Message);
        }
    }

    async Task OnDeleteBucket(Bucket bucket)
    {
        if (!await ConfirmDialog.AskAsync(DialogService, "Delete bucket",
                $"Delete \"{bucket.Name}\"? This will permanently remove all {bucket.ObjectCount} object(s) inside.", "Delete", danger: true)) return;

        try
        {
            await MetadataService.DeleteBucketAsync(bucket.Name, _currentUserId, _isPrivileged, _currentUserId);
            try
            {
                await StorageService.DeleteBucketAsync(bucket.Name);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Blob folder of bucket {Bucket} could not be deleted and is left for the orphan cleanup job", bucket.Name);
            }
            await LoadBuckets();
            NotificationService.Notify(NotificationSeverity.Success, "Bucket deleted", bucket.Name);
        }
        catch (UnauthorizedAccessException)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Forbidden", "You do not own this bucket.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to delete bucket", ex.Message);
        }
    }

    async Task OnChangeOwner(Bucket bucket)
    {
        var result = await DialogService.OpenAsync<ChangeOwnerDialog>("Change owner",
            new Dictionary<string, object?> { { "Bucket", bucket } },
            new DialogOptions { Width = OxSizes.DialogSmall, CloseDialogOnOverlayClick = true, ShowClose = true });

        if (result is not ChangeOwnerDialog.Result r) return;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.Buckets
                .Where(b => b.Id == bucket.Id)
                .ExecuteUpdateAsync(s => s.SetProperty(b => b.OwnerId, r.UserId));

            db.AuditEntries.Add(new AuditEntry { UserId = _currentUserId, Action = "ChangeOwner", BucketName = bucket.Name, Details = $"New owner: {r.UserName}" });
            await db.SaveChangesAsync();
        }

        await LoadBuckets();
        NotificationService.Notify(NotificationSeverity.Success, "Owner changed",
            $"\"{bucket.Name}\" is now owned by {r.UserName}.");
    }
}

@page "/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Manager")]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using ObjeX.Core.Models
@using ObjeX.Infrastructure.Data
@using ObjeX.Web.Components.Dialogs
@using ObjeX.Web.Helpers
@using Microsoft.Extensions.Options
@using ObjeX.Infrastructure.Options
@inject UserManager<User> UserManager
@inject IDbContextFactory<ObjeXDbContext> DbFactory
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject IOptions<DefaultAdminOptions> DefaultAdmin
@inject BrowserTimeZone Tz

<PageTitle>Users — ObjeX</PageTitle>

<OxPageHeader Title="Users" Meta="@(_users.Count == 1 ? "1 user" : $"{_users.Count:N0} users")">
    <OxButton Variant="OxButtonVariant.Primary" Icon="person_add" OnClick="CreateUser">New user</OxButton>
</OxPageHeader>

@if (!_loaded)
{
    <OxSkeleton Shape="OxSkeletonShape.Rows" Count="4" />
}
else
{
    <RadzenDataGrid Data="_users" TItem="UserRow" AllowSorting="true" AllowAlternatingRows="false">
        <Columns>
            <RadzenDataGridColumn TItem="UserRow" Property="Username" Title="User">
                <Template Context="row">
                    <OxStack Row="true" Gap="5" Align="OxAlign.Baseline">
                        <OxText><strong>@row.Username</strong></OxText>
                        <OxTooltip Text="@row.Email" WhenTruncated="true"><OxText Variant="OxTextVariant.Small" Truncate="true">@row.Email</OxText></OxTooltip>
                    </OxStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserRow" Property="Role" Title="Role" Width="@OxSizes.NumberColumn">
                <Template Context="row"><OxBadge Tone="@(row.Role == "Admin" ? OxTone.Accent : OxTone.Default)">@row.Role</OxBadge></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserRow" Property="Status" Title="Status" Width="@OxSizes.DateColumn">
                <Template Context="row">
                    @if (row.IsDeactivated)
                    {
                        <OxBadge Tone="OxTone.Danger">Deactivated</OxBadge>
                    }
                    else if (row.IsLocked)
                    {
                        <OxStack Row="true" Gap="4" Align="OxAlign.Center">
                            <OxBadge Tone="OxTone.Warning">Locked</OxBadge>
                            <OxLink OnClick="@(() => Unlock(row))">Unlock</OxLink>
                        </OxStack>
                    }
                    else
                    {
                        <OxText Variant="OxTextVariant.Muted">Active</OxText>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserRow" Title="Storage" Width="@OxSizes.TypeColumn" Sortable="false">
                <Template Context="row">
                    <OxStack Gap="2">
                        <OxText Variant="OxTextVariant.Small">@FileHelper.FormatBytes(row.StorageUsed)@(row.Quota.HasValue ? $" / {FileHelper.FormatBytes(row.Quota.Value)}" : " / ∞")</OxText>
                        @if (row.Quota is > 0)
                        {
                            <OxMeter Value="@((double)row.StorageUsed / row.Quota.Value * 100)" Label="Quota used"
                                     Tone="@(row.StorageUsed > row.Quota.Value * 0.9 ? OxTone.Danger : OxTone.Default)" />
                        }
                    </OxStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserRow" Property="CreatedAt" Title="Created" Width="@OxSizes.DateColumn" CssClass="ox-col-muted">
                <Template Context="row"><OxTime Value="@row.CreatedAt" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserRow" Title="" Width="@OxSizes.MenuColumn" Sortable="false" CssClass="ox-col-actions">
                <Template Context="row">
                    <OxRowActions>
                        <OxMenuButton Label="@($"More actions for {row.Username}")">
                            <OxMenuItem Icon="sd_storage" OnClick="@(() => SetQuota(row))">Set storage quota</OxMenuItem>
                            @if (row.Id != _currentUserId && row.Role != "Admin")
                            {
                                @if (_currentUserIsAdmin)
                                {
                                    <OxMenuItem Icon="@(row.Role == "Manager" ? "person" : "manage_accounts")" OnClick="@(() => ToggleRole(row))">@(row.Role == "Manager" ? "Demote to User" : "Promote to Manager")</OxMenuItem>
                                }
                                @if (!row.IsDeactivated)
                                {
                                    <OxMenuItem Icon="lock_reset" OnClick="@(() => ResetPassword(row))">Reset password</OxMenuItem>
                                }
                                <OxMenuItem Icon="@(row.IsDeactivated ? "person_add" : "person_off")" OnClick="@(() => ToggleDeactivate(row))">@(row.IsDeactivated ? "Reactivate" : "Deactivate")</OxMenuItem>
                                <OxMenuDivider />
                                <OxMenuItem Icon="delete" Danger="true" OnClick="@(() => DeleteUser(row))">Delete</OxMenuItem>
                            }
                        </OxMenuButton>
                    </OxRowActions>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    record UserRow(string Id, string Username, string Email, string Role, bool IsDeactivated, bool IsLocked, DateTime CreatedAt, long StorageUsed, long? Quota)
    {
        public string Status => IsDeactivated ? "Deactivated" : IsLocked ? "Locked" : "Active";
    }

    List<UserRow> _users = [];
    string _currentUserId = string.Empty;
    bool _currentUserIsAdmin;
    bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _currentUserIsAdmin = auth.User.IsInRole("Admin");
        await LoadUsers();
        _loaded = true;
    }

    async Task LoadUsers()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var users = await db.Users.OrderBy(u => u.UserName).ToListAsync();
        var settings = await db.SystemSettings.FindAsync(1);
        var bucketSizes = await db.Buckets
            .GroupBy(b => b.OwnerId)
            .Select(g => new { OwnerId = g.Key, Total = g.Sum(b => b.TotalSize) })
            .ToDictionaryAsync(x => x.OwnerId, x => x.Total);

        // Batch-load all user-role mappings in a single query to avoid N+1
        var userRoles = await db.UserRoles
            .Join(db.Roles, ur => ur.RoleId, r => r.Id, (ur, r) => new { ur.UserId, RoleName = r.Name! })
            .ToListAsync();
        var rolesByUser = userRoles.GroupBy(x => x.UserId)
            .ToDictionary(g => g.Key, g => g.Select(x => x.RoleName).ToList());

        var now = DateTimeOffset.UtcNow;
        var rows = new List<UserRow>();
        foreach (var u in users)
        {
            var roles = rolesByUser.GetValueOrDefault(u.Id, []);
            var role = roles.Contains("Admin") ? "Admin" : roles.Contains("Manager") ? "Manager" : "User";
            var used = bucketSizes.GetValueOrDefault(u.Id, 0);
            var isPrivileged = role is "Admin" or "Manager";
            var quota = u.StorageQuotaBytes ?? (isPrivileged ? null : settings?.DefaultStorageQuotaBytes);
            rows.Add(new UserRow(u.Id, u.UserName ?? string.Empty, u.Email ?? string.Empty, role, u.IsDeactivated,
                u.LockoutEnd > now, u.CreatedAt, used, quota));
        }
        _users = rows;
    }

    static string GeneratePassword()
    {
        const string chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        var length = System.Security.Cryptography.RandomNumberGenerator.GetInt32(8, 13);
        return new string(Enumerable.Range(0, length)
            .Select(_ => chars[System.Security.Cryptography.RandomNumberGenerator.GetInt32(chars.Length)])
            .ToArray());
    }

    async Task CreateUser()
    {
        var result = await DialogService.OpenAsync<CreateUserDialog>("New user",
            options: new DialogOptions { Width = OxSizes.DialogSmall, CloseDialogOnOverlayClick = true, ShowClose = true });

        if (result is not CreateUserDialog.Result r) return;

        var password = GeneratePassword();
        var user = new User
        {
            UserName = r.Username,
            Email = r.Email,
            MustChangePassword = true,
            TemporaryPasswordExpiresAt = DateTime.UtcNow.AddHours(72)
        };

        var createResult = await UserManager.CreateAsync(user, password);
        if (!createResult.Succeeded)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed",
                createResult.Errors.First().Description);
            return;
        }

        await UserManager.AddToRoleAsync(user, r.Role);
        await LoadUsers();

        await DialogService.OpenAsync<ShowUserPasswordDialog>($"User created: {r.Username}",
            new Dictionary<string, object?> { { "Password", password } },
            options: new DialogOptions { Width = OxSizes.DialogMedium, CloseDialogOnOverlayClick = false, ShowClose = false });
    }

    async Task ToggleRole(UserRow row)
    {
        var isPromoting = row.Role == "User";
        var action = isPromoting ? "Promote to Manager" : "Demote to User";
        if (!await ConfirmDialog.AskAsync(DialogService, action, $"{action}: \"{row.Username}\"?", action)) return;

        var user = await UserManager.FindByIdAsync(row.Id);
        if (user is null) return;

        if (isPromoting)
        {
            await UserManager.AddToRoleAsync(user, "Manager");
        }
        else
        {
            await UserManager.RemoveFromRoleAsync(user, "Manager");
            await UserManager.AddToRoleAsync(user, "User");
        }

        await UserManager.UpdateSecurityStampAsync(user);
        await LoadUsers();
        NotificationService.Notify(NotificationSeverity.Success, action, $"\"{row.Username}\" role updated.");
    }

    async Task ResetPassword(UserRow row)
    {
        if (!await ConfirmDialog.AskAsync(DialogService, "Reset password", $"Reset password for \"{row.Username}\"? They will be required to change it on next login.", "Reset")) return;

        var user = await UserManager.FindByIdAsync(row.Id);
        if (user is null) return;

        var password = GeneratePassword();
        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var result = await UserManager.ResetPasswordAsync(user, token, password);
        if (!result.Succeeded)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed", result.Errors.First().Description);
            return;
        }

        user.MustChangePassword = true;
        user.TemporaryPasswordExpiresAt = DateTime.UtcNow.AddHours(72);
        await UserManager.UpdateAsync(user);
        await UserManager.UpdateSecurityStampAsync(user);

        await DialogService.OpenAsync<ShowUserPasswordDialog>($"New password: {row.Username}",
            new Dictionary<string, object?> { { "Password", password } },
            options: new DialogOptions { Width = OxSizes.DialogMedium, CloseDialogOnOverlayClick = false, ShowClose = false });
    }

    async Task ToggleDeactivate(UserRow row)
    {
        var user = await UserManager.FindByIdAsync(row.Id);
        if (user is null) return;

        var action = user.IsDeactivated ? "Reactivate" : "Deactivate";
        if (!await ConfirmDialog.AskAsync(DialogService, action, $"{action} user \"{row.Username}\"?", action)) return;

        user.IsDeactivated = !user.IsDeactivated;
        await UserManager.UpdateAsync(user);
        await UserManager.UpdateSecurityStampAsync(user);
        await LoadUsers();

        NotificationService.Notify(NotificationSeverity.Success, action + "d", $"\"{row.Username}\" {action.ToLower()}d.");
    }

    async Task SetQuota(UserRow row)
    {
        var currentGb = row.Quota.HasValue ? (int)(row.Quota.Value / (1024L * 1024 * 1024)) : 0;
        var input = await DialogService.OpenAsync<SetQuotaDialog>("Storage quota",
            new Dictionary<string, object?>
            {
                { nameof(SetQuotaDialog.Username), row.Username },
                { nameof(SetQuotaDialog.CurrentGb), currentGb },
                { nameof(SetQuotaDialog.Unlimited), row.Role is "Admin" or "Manager" },
            },
            new DialogOptions { Width = OxSizes.DialogSmall, CloseDialogOnOverlayClick = true });

        if (input is not int gb) return;

        var user = await UserManager.FindByIdAsync(row.Id);
        if (user is null) return;

        user.StorageQuotaBytes = gb == 0 ? null : gb * 1024L * 1024 * 1024;
        user.UpdatedAt = DateTime.UtcNow;
        await UserManager.UpdateAsync(user);
        await LoadUsers();

        NotificationService.Notify(NotificationSeverity.Success, "Quota updated",
            gb == 0 ? $"\"{row.Username}\" set to system default" : $"\"{row.Username}\" set to {gb} GB");
    }

    async Task Unlock(UserRow row)
    {
        if (!await ConfirmDialog.AskAsync(DialogService, "Unlock", $"Unlock \"{row.Username}\"? Failed login attempts are reset.", "Unlock")) return;

        var user = await UserManager.FindByIdAsync(row.Id);
        if (user is null) return;

        await UserManager.SetLockoutEndDateAsync(user, null);
        await UserManager.ResetAccessFailedCountAsync(user);
        await LoadUsers();

        NotificationService.Notify(NotificationSeverity.Success, "Unlocked", $"\"{row.Username}\" unlocked.");
    }

    async Task DeleteUser(UserRow row)
    {
        if (!await ConfirmDialog.AskAsync(DialogService, "Delete user", $"Delete user \"{row.Username}\"? This cannot be undone.", "Delete", danger: true)) return;

        // The bucket FK is Restrict, so the rows must move to admin on the same fresh context that deletes the user.
        var adminUser = await UserManager.FindByNameAsync(DefaultAdmin.Value.Username);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var user = await db.Users.FindAsync(row.Id);
            if (user is null) return;

            if (adminUser is not null)
            {
                await db.Buckets
                    .Where(b => b.OwnerId == user.Id)
                    .ExecuteUpdateAsync(s => s.SetProperty(b => b.OwnerId, adminUser.Id));
            }

            db.Users.Remove(user);
            await db.SaveChangesAsync();
        }

        await LoadUsers();

        NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"User \"{row.Username}\" deleted.");
    }
}

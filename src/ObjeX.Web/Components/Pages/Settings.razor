@page "/settings"
@using Microsoft.EntityFrameworkCore
@using ObjeX.Core.Models
@using ObjeX.Core.Utilities
@using ObjeX.Infrastructure.Data
@using ObjeX.Web.Components.Dialogs
@using Microsoft.Extensions.Options
@using ObjeX.Infrastructure.Options
@implements IDisposable
@inject UiPreferences Preferences
@inject IOptions<S3Options> S3
@inject IDbContextFactory<ObjeXDbContext> DbFactory
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject BrowserTimeZone Tz

<PageTitle>Settings — ObjeX</PageTitle>

<OxPageHeader Title="Settings" />

<OxGrid>
    <OxCard Title="Appearance">
        <OxSettingRow Label="Dark mode">
            <OxSwitch Label="Dark mode" Checked="@Preferences.IsDark" CheckedChanged="@Preferences.SetDarkAsync" />
        </OxSettingRow>
    </OxCard>

    <OxCard Title="Preferences">
        <OxSettingRow Label="24-hour clock" Hint="Off shows 5:30 PM instead of 17:30.">
            <OxSwitch Label="24-hour clock" Checked="@(!Preferences.Hour12)" CheckedChanged="@(on => Preferences.SetHour12Async(!on))" />
        </OxSettingRow>
        <OxSettingRow Label="Relative times" Hint="12 min ago within a week; the exact time is the tooltip.">
            <OxSwitch Label="Relative times" Checked="@Preferences.RelativeTimes" CheckedChanged="@Preferences.SetRelativeTimesAsync" />
        </OxSettingRow>
        <OxSettingRow Label="Start page" Hint="Where you land after signing in.">
            <OxBox Width="OxWidth.Sm">
                <RadzenDropDown TValue="string" Value="@StartPage" ValueChanged="@((string path) => Preferences.SetStartPageAsync(path))" Data="@_startPages"
                                TextProperty="@nameof(StartPages.Page.Label)" ValueProperty="@nameof(StartPages.Page.Path)" aria-label="Start page" />
            </OxBox>
        </OxSettingRow>
        <OxText Variant="OxTextVariant.Small">Saved in this browser.</OxText>
    </OxCard>

    @if (_isAdmin || _isManager)
    {
        <OxCard Title="Presigned URLs">
            <OxSettingRow Label="Default expiry" Hint="Used when a share link is created without a choice.">
                <OxBox Width="OxWidth.Xs"><OxTextInput Type="number" min="1" AlignEnd="true" Value="@_defaultValue.ToString()" ValueChanged="OnDefaultValueInput" /></OxBox>
                <OxBox Width="OxWidth.Sm">
                    <RadzenDropDown @bind-Value="_defaultUnit" Data="_units"
                                    TextProperty="@nameof(TimeUnit.Label)" ValueProperty="@nameof(TimeUnit.Id)"
                                    Change="@(_ => ValidatePresignSettings())" />
                </OxBox>
            </OxSettingRow>
            <OxSettingRow Label="Maximum expiry" Hint="No link lives longer than this, whoever signs it.">
                <OxBox Width="OxWidth.Xs"><OxTextInput Type="number" min="1" AlignEnd="true" Value="@_maxValue.ToString()" ValueChanged="OnMaxValueInput" /></OxBox>
                <OxBox Width="OxWidth.Sm">
                    <RadzenDropDown @bind-Value="_maxUnit" Data="_units"
                                    TextProperty="@nameof(TimeUnit.Label)" ValueProperty="@nameof(TimeUnit.Id)"
                                    Change="@(_ => ValidatePresignSettings())" />
                </OxBox>
            </OxSettingRow>
            <OxStack Row="true" Justify="OxJustify.Between" Align="OxAlign.Center" Gap="6">
                <OxText Variant="OxTextVariant.Small" Tone="OxTone.Danger">@_presignError</OxText>
                <OxButton Variant="OxButtonVariant.Primary" Disabled="@(_presignError is not null)" OnClick="SavePresignSettings">Save</OxButton>
            </OxStack>
        </OxCard>

        <OxCard Title="Storage quotas">
            <OxSettingRow Label="Default quota per user" Hint="Applies to the User role only. Admins and Managers are unlimited by default. Set per-user overrides on the Users page.">
                <OxBox Width="OxWidth.Xs"><OxTextInput Type="number" min="0" AlignEnd="true" Placeholder="∞" Value="@(_quotaValue == 0 ? null : _quotaValue.ToString())" ValueChanged="OnQuotaValueInput" /></OxBox>
                <OxBox Width="OxWidth.Sm">
                    <RadzenDropDown @bind-Value="_quotaUnit" Data="_sizeUnits"
                                    TextProperty="@nameof(SizeUnit.Label)" ValueProperty="@nameof(SizeUnit.Id)" />
                </OxBox>
            </OxSettingRow>
            <OxStack Row="true" Justify="OxJustify.End">
                <OxButton Variant="OxButtonVariant.Primary" OnClick="SaveQuotaSettings">Save</OxButton>
            </OxStack>
        </OxCard>
    }
</OxGrid>

<OxCard Title="S3 credentials">
    <Actions>
        <OxButton Variant="OxButtonVariant.Primary" Icon="add" OnClick="CreateCredential">New credential</OxButton>
    </Actions>
    <ChildContent>
        <OxStack Row="true" Wrap="true" Align="OxAlign.Center" Gap="8">
            <OxStack Row="true" Align="OxAlign.Center" Gap="4">
                <OxText Variant="OxTextVariant.Label">Endpoint</OxText>
                <OxCode Text="@Endpoint" Copyable="true" />
            </OxStack>
            <OxStack Row="true" Align="OxAlign.Center" Gap="4">
                <OxText Variant="OxTextVariant.Label">Region</OxText>
                <OxCode Text="@S3Conventions.Region" Copyable="true" />
            </OxStack>
            <OxStack Row="true" Align="OxAlign.Center" Gap="4">
                <OxText Variant="OxTextVariant.Label">Addressing</OxText>
                <OxCode Text="@S3Conventions.AddressingStyle" />
            </OxStack>
        </OxStack>

        @if (IsDefaultEndpoint)
        {
            <OxText Variant="OxTextVariant.Small">Local endpoint. Clients on other machines need the public URL, set via S3:PublicUrl.</OxText>
        }

        @if (_credentials.Count == 0)
        {
            <OxEmptyState Icon="key" Title="No S3 credentials yet">Create one to access your buckets through the S3 API.</OxEmptyState>
        }
        else
        {
            <RadzenDataGrid Data="_credentials" TItem="S3Credential" AllowSorting="false" AllowAlternatingRows="false">
                <Columns>
                    <RadzenDataGridColumn TItem="S3Credential" Property="Name" Title="Name">
                        <Template Context="cred"><OxText Truncate="true"><strong>@cred.Name</strong></OxText></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="S3Credential" Property="AccessKeyId" Title="Access key ID" Width="@OxSizes.NameColumn">
                        <Template Context="cred"><OxText Variant="OxTextVariant.Mono">@cred.AccessKeyId</OxText></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="S3Credential" Property="CreatedAt" Title="Created" Width="@OxSizes.DateColumn" CssClass="ox-col-muted">
                        <Template Context="cred"><OxTime Value="@cred.CreatedAt" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="S3Credential" Property="LastUsedAt" Title="Last used" Width="@OxSizes.DateColumn" CssClass="ox-col-muted">
                        <Template Context="cred"><OxTime Value="@cred.LastUsedAt" Empty="Never" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="S3Credential" Title="" Width="@OxSizes.ActionsColumn" Sortable="false" CssClass="ox-col-actions">
                        <Template Context="cred">
                            <OxRowActions>
                                <OxIconButton Icon="terminal" Label="Connect" OnClick="@(() => ShowConnect(cred))" />
                                <OxMenuButton Label="@($"More actions for {cred.Name}")">
                                    <OxMenuItem Icon="delete" Danger="true" OnClick="@(() => DeleteCredential(cred))">Delete</OxMenuItem>
                                </OxMenuButton>
                            </OxRowActions>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </ChildContent>
</OxCard>

@code {
    bool _isAdmin;
    bool _isManager;
    IReadOnlyList<StartPages.Page> _startPages = [];
    string StartPage => _startPages.Any(p => p.Path == Preferences.StartPage) ? Preferences.StartPage! : StartPages.Default;
    string _userId = string.Empty;
    List<S3Credential> _credentials = [];
    string Endpoint => S3.Value.PublicUrl.TrimEnd('/');
    bool IsDefaultEndpoint => Endpoint == new S3Options().PublicUrl.TrimEnd('/');

    // Quota config (admin)
    int _quotaValue;
    string _quotaUnit = "GB";

    record SizeUnit(string Id, string Label, long Multiplier);
    static readonly List<SizeUnit> _sizeUnits =
    [
        new("MB", "MB", 1024L * 1024),
        new("GB", "GB", 1024L * 1024 * 1024),
        new("TB", "TB", 1024L * 1024 * 1024 * 1024),
    ];

    // Presigned URL settings
    int _defaultValue = 1;
    string _defaultUnit = "hours";
    int _maxValue = 7;
    string _maxUnit = "days";
    string? _presignError;

    record TimeUnit(string Id, string Label, int Multiplier);
    static readonly List<TimeUnit> _units =
    [
        new("minutes", "Minutes", 60),
        new("hours",   "Hours",   3600),
        new("days",    "Days",    86400),
    ];

    int DefaultSeconds => _defaultValue * _units.First(u => u.Id == _defaultUnit).Multiplier;
    int MaxSeconds     => _maxValue     * _units.First(u => u.Id == _maxUnit).Multiplier;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _isAdmin = auth.User.IsInRole("Admin");
        _isManager = auth.User.IsInRole("Manager");
        _startPages = StartPages.For(auth.User.IsInRole);
        Preferences.Changed += OnPreferencesChanged;
        await LoadCredentials();
        if (_isAdmin || _isManager)
        {
            await LoadPresignSettings();
            await LoadQuotaSettings();
        }
    }

    async Task LoadPresignSettings()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.SystemSettings.FindAsync(1);
        var defaultSec = settings?.PresignedUrlDefaultExpirySeconds ?? 3600;
        var maxSec     = settings?.PresignedUrlMaxExpirySeconds ?? 604800;

        (_defaultValue, _defaultUnit) = SecondsToValueUnit(defaultSec);
        (_maxValue,     _maxUnit)     = SecondsToValueUnit(maxSec);
    }

    static (int Value, string Unit) SecondsToValueUnit(int seconds)
    {
        if (seconds % 86400 == 0) return (seconds / 86400, "days");
        if (seconds % 3600  == 0) return (seconds / 3600,  "hours");
        return (seconds / 60, "minutes");
    }

    void OnDefaultValueInput(string value)
    {
        if (int.TryParse(value, out var v) && v >= 1)
            _defaultValue = v;
        ValidatePresignSettings();
    }

    void OnMaxValueInput(string value)
    {
        if (int.TryParse(value, out var v) && v >= 1)
            _maxValue = v;
        ValidatePresignSettings();
    }

    void ValidatePresignSettings()
    {
        _presignError = DefaultSeconds > MaxSeconds
            ? "Default expiry must not exceed the maximum expiry."
            : null;
    }

    async Task SavePresignSettings()
    {
        ValidatePresignSettings();
        if (_presignError is not null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.SystemSettings.FindAsync(1);
        if (settings is null)
        {
            settings = new ObjeX.Core.Models.SystemSettings { Id = 1 };
            db.SystemSettings.Add(settings);
        }
        settings.PresignedUrlDefaultExpirySeconds = DefaultSeconds;
        settings.PresignedUrlMaxExpirySeconds     = MaxSeconds;
        await db.SaveChangesAsync();

        NotificationService.Notify(NotificationSeverity.Success, "Saved", "Presigned URL settings updated.");
    }

    async Task LoadQuotaSettings()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.SystemSettings.FindAsync(1);
        var bytes = settings?.DefaultStorageQuotaBytes;
        if (bytes is null || bytes == 0)
        {
            _quotaValue = 0;
            _quotaUnit = "GB";
        }
        else
        {
            (_quotaValue, _quotaUnit) = BytesToValueUnit(bytes.Value);
        }
    }

    static (int Value, string Unit) BytesToValueUnit(long bytes)
    {
        if (bytes % (1024L * 1024 * 1024 * 1024) == 0) return ((int)(bytes / (1024L * 1024 * 1024 * 1024)), "TB");
        if (bytes % (1024L * 1024 * 1024) == 0) return ((int)(bytes / (1024L * 1024 * 1024)), "GB");
        return ((int)(bytes / (1024L * 1024)), "MB");
    }

    // An empty field is the unlimited quota its placeholder shows.
    void OnQuotaValueInput(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            _quotaValue = 0;
        else if (int.TryParse(value, out var v) && v >= 0)
            _quotaValue = v;
    }

    async Task SaveQuotaSettings()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.SystemSettings.FindAsync(1);
        if (settings is null)
        {
            settings = new SystemSettings { Id = 1 };
            db.SystemSettings.Add(settings);
        }

        settings.DefaultStorageQuotaBytes = _quotaValue == 0
            ? null
            : _quotaValue * _sizeUnits.First(u => u.Id == _quotaUnit).Multiplier;

        await db.SaveChangesAsync();
        NotificationService.Notify(NotificationSeverity.Success, "Saved", "Storage quota updated.");
    }

    // The sidebar changes the same preferences; the switches follow it.
    void OnPreferencesChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Preferences.Changed -= OnPreferencesChanged;

    async Task LoadCredentials()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _credentials = await db.S3Credentials
            .Where(c => c.UserId == _userId)
            .OrderByDescending(c => c.CreatedAt)
            .ToListAsync();
    }

    async Task ShowConnect(S3Credential cred)
    {
        await DialogService.OpenAsync<S3ConnectDialog>($"Connect · {cred.Name}",
            new Dictionary<string, object?>
            {
                { "AccessKeyId", cred.AccessKeyId },
                { "Endpoint", Endpoint }
            },
            new DialogOptions { CloseDialogOnOverlayClick = true, ShowClose = true, Width = OxSizes.DialogWide });
    }

    async Task CreateCredential()
    {
        var result = await DialogService.OpenAsync<CreateS3CredentialDialog>("New S3 credential",
            options: new DialogOptions { Width = OxSizes.DialogSmall, CloseDialogOnOverlayClick = true, ShowClose = true });

        if (result is not CreateS3CredentialDialog.Result r) return;

        var (credential, secret) = S3Credential.Create(r.Name, _userId);
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.S3Credentials.Add(credential);
            await db.SaveChangesAsync();
        }
        await LoadCredentials();

        await DialogService.OpenAsync<ShowS3CredentialDialog>("Your new S3 credential",
            new Dictionary<string, object?>
            {
                { "AccessKeyId", credential.AccessKeyId },
                { "SecretAccessKey", secret },
                { "Endpoint", Endpoint }
            },
            options: new DialogOptions { CloseDialogOnOverlayClick = false, ShowClose = false, Width = OxSizes.DialogWide });
    }

    async Task DeleteCredential(S3Credential cred)
    {
        if (!await ConfirmDialog.AskAsync(DialogService, "Delete credential",
                $"Delete credential \"{cred.Name}\"? Links signed with it stop working. This cannot be undone.", "Delete", danger: true)) return;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            // The row was loaded on an already-disposed context, so Remove attaches it as Deleted.
            db.S3Credentials.Remove(cred);
            await db.SaveChangesAsync();
        }
        await LoadCredentials();

        NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"Credential \"{cred.Name}\" deleted.");
    }
}

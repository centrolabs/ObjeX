@page "/change-password"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ObjeX.Core.Models
@attribute [Authorize]
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Change password — ObjeX</PageTitle>

<OxContainer Narrow="true">
    <OxStack Gap="2">
        <OxBrand />
        <OxText Variant="OxTextVariant.Muted">Change your password to continue</OxText>
    </OxStack>

    <OxCard>
        <OxField Label="New password">
            <OxTextInput Type="password" @bind-Value="_newPassword" OnEnter="OnEnter" autocomplete="new-password" AutoFocus="true" />
        </OxField>
        <OxField Label="Confirm new password" Error="@_error" ReserveError="true">
            <OxTextInput Type="password" @bind-Value="_confirmPassword" OnEnter="OnEnter" Invalid="@(_error is not null)" autocomplete="new-password" />
        </OxField>
        <OxButton Variant="OxButtonVariant.Primary" Block="true" Disabled="@(!CanSubmit)" OnClick="OnSubmit">Set password</OxButton>
    </OxCard>
</OxContainer>

@code {
    User? _user;
    string _newPassword = string.Empty;
    string _confirmPassword = string.Empty;
    string? _error;

    bool CanSubmit => !string.IsNullOrWhiteSpace(_newPassword) && !string.IsNullOrWhiteSpace(_confirmPassword);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _user = await UserManager.FindByIdAsync(userId!);

        // Guard: if user doesn't need to change password, send them home
        if (_user is null || !_user.MustChangePassword)
            Navigation.NavigateTo("/", forceLoad: true);
    }

    async Task OnSubmit()
    {
        _error = null;

        if (_newPassword.Length < 4)
        {
            _error = "Password must be at least 4 characters.";
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            _error = "Passwords do not match.";
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(_user!);
        var result = await UserManager.ResetPasswordAsync(_user!, token, _newPassword);
        if (!result.Succeeded)
        {
            _error = result.Errors.First().Description;
            return;
        }

        _user!.MustChangePassword = false;
        _user.TemporaryPasswordExpiresAt = null;
        await UserManager.UpdateAsync(_user);

        Navigation.NavigateTo("/", forceLoad: true);
    }

    Task OnEnter() => CanSubmit ? OnSubmit() : Task.CompletedTask;
}

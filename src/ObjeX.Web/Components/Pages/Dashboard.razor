@page "/"
@using ObjeX.Core.Interfaces
@using ObjeX.Core.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IMetadataService MetadataService
@inject IStorageQuotaService QuotaService
@inject IStorageSpaceService SpaceService
@inject ILogger<Dashboard> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject BrowserTimeZone Tz
@inject NotificationService NotificationService
@inject IJobMonitor Jobs
@inject NavigationManager Navigation

<PageTitle>Dashboard — ObjeX</PageTitle>

<OxPageHeader Title="Dashboard" Meta="@($"Updated {Tz.FormatSeconds(_lastUpdated)}")">
    <OxIconButton Icon="refresh" Label="Refresh" OnClick="Refresh" Busy="@_refreshing" />
</OxPageHeader>

@if (_disk is { IsBelowMinimum: true })
{
    <OxAlert Tone="OxTone.Danger">The disk has @FileHelper.FormatBytes(_disk.FreeBytes) free, below the minimum of @FileHelper.FormatBytes(_disk.MinimumFreeBytes). Uploads are rejected.</OxAlert>
}
else if (_disk is { IsNearMinimum: true })
{
    <OxAlert Tone="OxTone.Warning">The disk has @FileHelper.FormatBytes(_disk.FreeBytes) free. Uploads stop below @FileHelper.FormatBytes(_disk.MinimumFreeBytes).</OxAlert>
}

@if (_failedJobs.Count > 0)
{
    <OxAlert Tone="OxTone.Warning">@FailedJobsText <OxLink Href="/jobs">Open Jobs</OxLink></OxAlert>
}

@* Until the first load ends, shapes stand in for figures and rows, so navigating here never flashes "No buckets yet". *@
@if (!_loaded)
{
    <OxCard>
        <OxStack Row="true" Wrap="true" Gap="9">
            @for (var i = 0; i < 4; i++)
            {
                <OxStack Gap="3"><OxSkeleton Shape="OxSkeletonShape.Line" /><OxSkeleton Shape="OxSkeletonShape.Figure" /></OxStack>
            }
        </OxStack>
    </OxCard>
}
else
{
    <OxCard>
        <OxStack Row="true" Wrap="true" Gap="9">
            @if (_isPrivileged)
            {
                <OxStat Label="Storage used" Value="@FileHelper.FormatBytes(_totalSize)" Hint="all buckets" />
            }
            <OxStat Label="My storage" Value="@FileHelper.FormatBytes(_myStorage?.UsedBytes ?? 0)"
                    Hint="@(_myStorage is { HasQuota: true } ? $"of {FileHelper.FormatBytes(_myStorage.QuotaBytes!.Value)}" : "no quota")">
                @if (_myStorage is { HasQuota: true })
                {
                    <OxMeter Value="@_myStorage.UsedPercent" Label="Quota used" Tone="@(_myStorage.UsedPercent > 90 ? OxTone.Danger : OxTone.Default)" />
                }
            </OxStat>
            <OxStat Label="Objects" Value="@_totalObjects.ToString("N0")"
                    Hint="@(_totalObjects > 0 ? $"avg {FileHelper.FormatBytes(_totalSize / _totalObjects)}" : null)" />
            <OxStat Label="Buckets" Value="@_buckets.Count.ToString("N0")" />
        </OxStack>
    </OxCard>
}

@if (_loaded && _buckets.Count >= 2)
{
    <OxStack Row="true" Wrap="true" Gap="7">
        <OxStack Grow="true">
            <OxCard Title="Storage by bucket">
                <OxText Variant="OxTextVariant.Small">Top 5 by size</OxText>
                <OxChart Clickable="true">
                    <RadzenChart SeriesClick="OpenSlice">
                        <RadzenDonutSeries Data="@_topBySize" CategoryProperty="Name" ValueProperty="TotalSize" TItem="Bucket" InnerRadius="60"
                                           Fills="@_topBySize.Select(SlotOf)" Strokes="@SurfaceStrokes" StrokeWidth="2">
                            <TooltipTemplate Context="data">
                                <OxStack Gap="1">
                                    <OxText><strong>@data.Name</strong></OxText>
                                    <OxText Variant="OxTextVariant.Small">@FileHelper.FormatBytes(data.TotalSize)@(_totalSize > 0 ? $" · {(double)data.TotalSize / _totalSize * 100:F1}%" : null)</OxText>
                                </OxStack>
                            </TooltipTemplate>
                        </RadzenDonutSeries>
                    </RadzenChart>
                </OxChart>
            </OxCard>
        </OxStack>
        <OxStack Grow="true">
            <OxCard Title="Objects by bucket">
                <OxText Variant="OxTextVariant.Small">Top 5 by count</OxText>
                <OxChart Clickable="true">
                    <RadzenChart SeriesClick="OpenSlice">
                        <RadzenDonutSeries Data="@_topByCount" CategoryProperty="Name" ValueProperty="ObjectCount" TItem="Bucket" InnerRadius="60"
                                           Fills="@_topByCount.Select(SlotOf)" Strokes="@SurfaceStrokes" StrokeWidth="2">
                            <TooltipTemplate Context="data">
                                <OxStack Gap="1">
                                    <OxText><strong>@data.Name</strong></OxText>
                                    <OxText Variant="OxTextVariant.Small">@data.ObjectCount.ToString("N0") objects@(_totalObjects > 0 ? $" · {(double)data.ObjectCount / _totalObjects * 100:F1}%" : null)</OxText>
                                </OxStack>
                            </TooltipTemplate>
                        </RadzenDonutSeries>
                    </RadzenChart>
                </OxChart>
            </OxCard>
        </OxStack>
        @if (_fileTypeStats.Count >= 2)
        {
            <OxStack Grow="true">
                <OxCard Title="File types">
                    <OxText Variant="OxTextVariant.Small">Top 8 by extension</OxText>
                    <OxChart>
                        <RadzenChart>
                            <RadzenDonutSeries Data="@_fileTypeStats" CategoryProperty="Label" ValueProperty="Count" TItem="FileTypeStat" InnerRadius="60"
                                               Fills="@OxChart.Slots" Strokes="@SurfaceStrokes" StrokeWidth="2">
                                <TooltipTemplate Context="data">
                                    <OxStack Gap="1">
                                        <OxText><strong>@data.Label</strong></OxText>
                                        <OxText Variant="OxTextVariant.Small">@data.Count.ToString("N0") files@(_totalFileTypeCount > 0 ? $" · {(double)data.Count / _totalFileTypeCount * 100:F1}%" : null)</OxText>
                                    </OxStack>
                                </TooltipTemplate>
                            </RadzenDonutSeries>
                        </RadzenChart>
                    </OxChart>
                </OxCard>
            </OxStack>
        }
    </OxStack>
}

@if (!_loaded)
{
    <OxCard Title="Buckets" Flush="true"><OxSkeleton Shape="OxSkeletonShape.Rows" Count="3" /></OxCard>
}
else if (_buckets.Count > 0)
{
    <OxCard Title="Buckets" Flush="true">
        <RadzenDataGrid class="@($"{OxSizes.WideGridClass} {OxSizes.ClickableGridClass}")" Data="@_buckets" TItem="Bucket" AllowSorting="true" AllowAlternatingRows="false"
                        RowClick="@OpenBucket">
            <Columns>
                <RadzenDataGridColumn TItem="Bucket" Property="Name" Title="Name">
                    <Template Context="b"><OxFileName Kind="OxFileKind.Bucket" Href="@($"/buckets/{b.Name}")">@b.Name</OxFileName></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Bucket" Property="ObjectCount" Title="Objects" Width="@OxSizes.NumberColumn" TextAlign="TextAlign.End">
                    <Template Context="b">@b.ObjectCount.ToString("N0")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Bucket" Property="TotalSize" Title="Size" Width="@OxSizes.SizeColumn" TextAlign="TextAlign.End">
                    <Template Context="b">@FileHelper.FormatBytes(b.TotalSize)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Bucket" Title="Share" Width="@OxSizes.NameColumn" Sortable="false">
                    <Template Context="b">
                        @if (_totalSize > 0)
                        {
                            var pct = (double)b.TotalSize / _totalSize * 100;
                            <OxStack Row="true" Align="OxAlign.Center" Gap="4">
                                <OxStack Grow="true"><OxMeter Value="@pct" Label="@($"Share of {b.Name}")" /></OxStack>
                                <OxBox Width="OxWidth.Xs"><OxText Variant="OxTextVariant.Small">@pct.ToString("F1")%</OxText></OxBox>
                            </OxStack>
                        }
                    </Template>
                </RadzenDataGridColumn>
                @if (_isPrivileged)
                {
                    <RadzenDataGridColumn TItem="Bucket" Property="Owner.UserName" Title="Owner" Width="@OxSizes.TypeColumn" CssClass="ox-col-muted">
                        <Template Context="b">@b.Owner?.UserName</Template>
                    </RadzenDataGridColumn>
                }
                <RadzenDataGridColumn TItem="Bucket" Property="UpdatedAt" Title="Modified" Width="@OxSizes.DateColumn" CssClass="ox-col-muted">
                    <Template Context="b"><OxTime Value="@b.UpdatedAt" /></Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </OxCard>
}
else
{
    <OxCard>
        <OxEmptyState Icon="inventory_2" Title="No buckets yet">
            <ChildContent>Create a bucket to store objects.</ChildContent>
            <Action><OxButton Variant="OxButtonVariant.Primary" Icon="add" Href="/buckets">Go to Buckets</OxButton></Action>
        </OxEmptyState>
    </OxCard>
}

@code {
    record FileTypeStat(string Label, int Count);

    List<Bucket> _buckets = [];
    List<Bucket> _topBySize = [];
    List<Bucket> _topByCount = [];
    List<FileTypeStat> _fileTypeStats = [];
    long _totalObjects;
    long _totalSize;
    int _totalFileTypeCount;
    DateTime _lastUpdated = DateTime.UtcNow;
    Timer? _timer;
    string _currentUserId = string.Empty;
    bool _isPrivileged;
    bool _isAdmin;
    List<RecurringJobStatus> _failedJobs = [];
    StorageQuotaStatus? _myStorage;
    StorageSpaceStatus? _disk;
    static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(30);
    string? _fingerprint;
    int _polling;
    bool _refreshing;
    bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _isPrivileged = auth.User.IsInRole("Admin") || auth.User.IsInRole("Manager");
        _isAdmin = auth.User.IsInRole("Admin");
        await LoadStats(MetadataService, QuotaService);
        _loaded = true;
        _timer = new Timer(async _ =>
        {
            if (Interlocked.Exchange(ref _polling, 1) == 1) return;
            try
            {
                // The timer runs beside the circuit's own work, so it must not share the circuit's scoped context.
                await using var scope = ScopeFactory.CreateAsyncScope();
                var changed = await LoadStats(scope.ServiceProvider.GetRequiredService<IMetadataService>(),
                    scope.ServiceProvider.GetRequiredService<IStorageQuotaService>());
                if (changed)
                    await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                // An unhandled exception in a Timer callback takes the whole process down.
                Logger.LogWarning(ex, "Dashboard refresh failed");
            }
            finally
            {
                Interlocked.Exchange(ref _polling, 0);
            }
        }, null, PollInterval, PollInterval);
    }

    // Shares the timer's guard, so a click and a tick never write the fields at the same time. During a tick the click only spins; the tick renders.
    async Task Refresh()
    {
        if (_refreshing) return;
        _refreshing = true;
        var ownsGuard = Interlocked.Exchange(ref _polling, 1) == 0;
        try
        {
            var feedback = Task.Delay(OxMotion.SpinTurn);
            if (ownsGuard)
            {
                // A click always reloads and moves the timestamp, even when the fingerprint is unchanged.
                _fingerprint = null;
                await LoadStats(MetadataService, QuotaService);
            }
            await feedback;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Dashboard refresh failed");
            NotificationService.Notify(NotificationSeverity.Error, "Refresh failed", ex.Message);
        }
        finally
        {
            _refreshing = false;
            if (ownsGuard) Interlocked.Exchange(ref _polling, 0);
        }
    }

    // The bucket rows are few and change with every upload or delete, so they decide whether the GROUP BY over all objects runs at all.
    async Task<bool> LoadStats(IMetadataService metadata, IStorageQuotaService quotas)
    {
        // Free space moves without any bucket changing, so the disk alert carries its own change check.
        var disk = SpaceService.Get();
        var statusChanged = DiskLabel(disk) != DiskLabel(_disk);
        _disk = disk;

        // Jobs fail without any bucket changing too.
        List<RecurringJobStatus> failedJobs = _isAdmin ? FailedJobs() : [];
        statusChanged |= JobsLabel(failedJobs) != JobsLabel(_failedJobs);
        _failedJobs = failedJobs;

        var buckets = (await metadata.ListBucketsAsync(_isPrivileged ? null : _currentUserId)).OrderByDescending(b => b.TotalSize).ToList();
        var fingerprint = string.Join("|", buckets.Select(b => $"{b.Name}:{b.ObjectCount}:{b.TotalSize}:{b.UpdatedAt.Ticks}"));
        if (fingerprint == _fingerprint)
        {
            if (statusChanged) _lastUpdated = DateTime.UtcNow;
            return statusChanged;
        }

        _fingerprint = fingerprint;
        _buckets = buckets;
        _myStorage = await quotas.GetAsync(_currentUserId);
        _totalObjects = _buckets.Sum(b => b.ObjectCount);
        _totalSize    = _buckets.Sum(b => b.TotalSize);
        _topBySize  = _buckets.Take(5).ToList();
        _topByCount = _buckets.OrderByDescending(b => b.ObjectCount).Take(5).ToList();

        var ownedBucketNames = _buckets.Select(b => b.Name).ToList();
        var contentTypeStats = (await metadata.GetContentTypeStatsAsync(ownedBucketNames)).ToList();

        _fileTypeStats = contentTypeStats
            .GroupBy(s => MimeToExtension(s.ContentType))
            .Select(g => new FileTypeStat(g.Key, g.Sum(s => s.Count)))
            .OrderByDescending(x => x.Count)
            .Take(8)
            .ToList();

        _totalFileTypeCount = _fileTypeStats.Sum(x => x.Count);
        _lastUpdated = DateTime.UtcNow;
        return true;
    }

    // Only what the disk card renders, so the card refreshes when it would look different.
    static string DiskLabel(StorageSpaceStatus? disk) =>
        disk is null ? "" : $"{FileHelper.FormatBytes(disk.FreeBytes)}|{disk.IsBelowMinimum}|{disk.IsNearMinimum}";

    // Only the last run of each job counts: a failure that a later run fixed needs no alert.
    List<RecurringJobStatus> FailedJobs()
    {
        try
        {
            return Jobs.GetRecurringJobs().Where(j => j.LastJob?.State is JobRunState.Failed or JobRunState.Retrying).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Job states could not be read for the dashboard");
            return [];
        }
    }

    static string JobsLabel(List<RecurringJobStatus> jobs) => string.Join("|", jobs.Select(j => $"{j.Id}:{j.LastJob?.Id}:{j.LastJob?.State}"));

    string FailedJobsText => _failedJobs switch
    {
        [var job] => $"The background job \"{job.Name}\" {(job.LastJob!.State == JobRunState.Retrying ? "failed and is retrying" : "failed")}"
                     + (job.LastJob.StartedAt is { } at ? $" (run started {Tz.Format(at)})." : "."),
        var jobs => $"{jobs.Count} background jobs failed on their last run: {string.Join(", ", jobs.Select(j => j.Name))}."
    };

    void OpenSlice(SeriesClickEventArgs args)
    {
        if (args.Data is Bucket bucket)
            Navigation.NavigateTo($"/buckets/{Uri.EscapeDataString(bucket.Name)}");
    }

    // A modified click on the name link opens a new tab; the page itself stays where it is.
    void OpenBucket(DataGridRowMouseEventArgs<Bucket> args)
    {
        if (args.Data is null || args.CtrlKey || args.MetaKey || args.ShiftKey) return;
        Navigation.NavigateTo($"/buckets/{Uri.EscapeDataString(args.Data.Name)}");
    }

    static string MimeToExtension(string contentType) => contentType switch
    {
        "application/pdf" => ".pdf",
        "application/zip" => ".zip",
        "application/gzip" => ".gz",
        "application/json" => ".json",
        "application/xml" => ".xml",
        "application/octet-stream" => "binary",
        "application/msword" => ".doc",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => ".docx",
        "application/vnd.ms-excel" => ".xls",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => ".xlsx",
        "application/vnd.ms-powerpoint" => ".ppt",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation" => ".pptx",
        "application/x-directory" => "folder",
        "text/plain" => ".txt",
        "text/html" => ".html",
        "text/css" => ".css",
        "text/csv" => ".csv",
        "text/markdown" => ".md",
        _ => contentType.Contains('/')
            ? "." + contentType[(contentType.LastIndexOf('/') + 1)..]
                .Replace("x-", "")
                .Split('+', ';')[0]
            : contentType
    };

    // A bucket keeps its chart colour in both bucket charts: the slot comes from its rank by size, not from its place in one chart.
    string SlotOf(Bucket bucket) => OxChart.Slot(_buckets.IndexOf(bucket));

    static readonly IEnumerable<string> SurfaceStrokes = Enumerable.Repeat(OxChart.Surface, 9);

    public void Dispose() => _timer?.Dispose();
}

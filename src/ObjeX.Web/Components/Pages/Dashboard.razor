@page "/"
@using ObjeX.Core.Interfaces
@using ObjeX.Core.Models
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IMetadataService MetadataService
@inject IStorageQuotaService QuotaService
@inject IStorageSpaceService SpaceService
@inject ILogger<Dashboard> Logger
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard — ObjeX</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.H4">Dashboard</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-text-secondary-color)">
            Updated @_lastUpdated.ToString("HH:mm:ss")
        </RadzenText>
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="flex-wrap:wrap">
        <RadzenCard class="stat-card">
            <RadzenStack Gap="0.4rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.Overline">Total Buckets</RadzenText>
                    <RadzenIcon Icon="folder" Style="color:var(--rz-primary);opacity:0.8;font-size:1.4rem" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.H3">@_buckets.Count</RadzenText>
            </RadzenStack>
        </RadzenCard>
        <RadzenCard class="stat-card">
            <RadzenStack Gap="0.4rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.Overline">Total Objects</RadzenText>
                    <RadzenIcon Icon="description" Style="color:var(--rz-primary);opacity:0.8;font-size:1.4rem" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.H3">@_totalObjects.ToString("N0")</RadzenText>
            </RadzenStack>
        </RadzenCard>
        <RadzenCard class="stat-card">
            <RadzenStack Gap="0.4rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.Overline">Storage Used</RadzenText>
                    <RadzenIcon Icon="save" Style="color:var(--rz-primary);opacity:0.8;font-size:1.4rem" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.H3">@FileHelper.FormatBytes(_totalSize)</RadzenText>
            </RadzenStack>
        </RadzenCard>
        <RadzenCard class="stat-card">
            <RadzenStack Gap="0.4rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.Overline">Avg Object Size</RadzenText>
                    <RadzenIcon Icon="compress" Style="color:var(--rz-primary);opacity:0.8;font-size:1.4rem" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.H3">@(_totalObjects > 0 ? FileHelper.FormatBytes(_totalSize / _totalObjects) : "—")</RadzenText>
            </RadzenStack>
        </RadzenCard>
        <RadzenCard class="stat-card">
            <RadzenStack Gap="0.4rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.Overline">My Storage</RadzenText>
                    <RadzenIcon Icon="person" Style="color:var(--rz-primary);opacity:0.8;font-size:1.4rem" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.H3">@FileHelper.FormatBytes(_myStorage?.UsedBytes ?? 0)</RadzenText>
                @if (_myStorage is { HasQuota: true })
                {
                    <RadzenText TextStyle="TextStyle.Caption">of @FileHelper.FormatBytes(_myStorage.QuotaBytes!.Value)</RadzenText>
                    <RadzenProgressBar Value="@_myStorage.UsedPercent" Max="100" ShowValue="false" Style="height:4px"
                                       ProgressBarStyle="@(_myStorage.UsedPercent > 90 ? ProgressBarStyle.Danger : ProgressBarStyle.Primary)" />
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Caption">no quota</RadzenText>
                }
            </RadzenStack>
        </RadzenCard>
        <RadzenCard class="stat-card">
            <RadzenStack Gap="0.4rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.Overline">Disk</RadzenText>
                    <RadzenIcon Icon="storage" Style="color:var(--rz-primary);opacity:0.8;font-size:1.4rem" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.H3">@FileHelper.FormatBytes(_disk?.FreeBytes ?? 0)</RadzenText>
                @if (_disk is not null)
                {
                    <RadzenText TextStyle="TextStyle.Caption">free of @FileHelper.FormatBytes(_disk.TotalBytes)</RadzenText>
                    <RadzenProgressBar Value="@_disk.UsedPercent" Max="100" ShowValue="false" Style="height:4px"
                                       ProgressBarStyle="@(_disk.IsBelowMinimum ? ProgressBarStyle.Danger : _disk.IsNearMinimum ? ProgressBarStyle.Warning : ProgressBarStyle.Primary)" />
                    @if (_disk.IsBelowMinimum)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-danger)">Uploads are rejected until space is freed</RadzenText>
                    }
                    else if (_disk.IsNearMinimum)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-warning)">Uploads stop below @FileHelper.FormatBytes(_disk.MinimumFreeBytes)</RadzenText>
                    }
                }
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>

    @if (_buckets.Count >= 2)
    {
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="flex-wrap:wrap">
            <RadzenCard Style="flex:1;min-width:260px;overflow:visible">
                <RadzenStack Gap="0.75rem">
                    <RadzenStack Gap="0.1rem">
                        <RadzenText TextStyle="TextStyle.H6">Storage by Bucket</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-text-secondary-color)">Top 5 by size</RadzenText>
                    </RadzenStack>
                    <RadzenChart Style="height:240px;overflow:visible">
                        <RadzenDonutSeries Data="@_topBySize" CategoryProperty="Name" ValueProperty="TotalSize"
                                           TItem="Bucket" InnerRadius="60">
                            <TooltipTemplate Context="data">
                                <div>
                                    <div style="font-weight:600;margin-bottom:2px">@data.Name</div>
                                    <div>@FileHelper.FormatBytes(data.TotalSize)</div>
                                    @if (_totalSize > 0)
                                    {
                                        <div style="opacity:0.7;font-size:0.85em">@($"{(double)data.TotalSize / _totalSize * 100:F1}%")</div>
                                    }
                                </div>
                            </TooltipTemplate>
                        </RadzenDonutSeries>
                    </RadzenChart>
                </RadzenStack>
            </RadzenCard>
            <RadzenCard Style="flex:1;min-width:260px;overflow:visible">
                <RadzenStack Gap="0.75rem">
                    <RadzenStack Gap="0.1rem">
                        <RadzenText TextStyle="TextStyle.H6">Objects by Bucket</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-text-secondary-color)">Top 5 by count</RadzenText>
                    </RadzenStack>
                    <RadzenChart Style="height:240px;overflow:visible">
                        <RadzenDonutSeries Data="@_topByCount" CategoryProperty="Name" ValueProperty="ObjectCount"
                                           TItem="Bucket" InnerRadius="60">
                            <TooltipTemplate Context="data">
                                <div>
                                    <div style="font-weight:600;margin-bottom:2px">@data.Name</div>
                                    <div>@data.ObjectCount.ToString("N0") objects</div>
                                    @if (_totalObjects > 0)
                                    {
                                        <div style="opacity:0.7;font-size:0.85em">@($"{(double)data.ObjectCount / _totalObjects * 100:F1}%")</div>
                                    }
                                </div>
                            </TooltipTemplate>
                        </RadzenDonutSeries>
                    </RadzenChart>
                </RadzenStack>
            </RadzenCard>
            @if (_fileTypeStats.Count >= 2)
            {
                <RadzenCard Style="flex:1;min-width:260px;overflow:visible">
                    <RadzenStack Gap="0.75rem">
                    <RadzenStack Gap="0.1rem">
                        <RadzenText TextStyle="TextStyle.H6">File Types</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-text-secondary-color)">Top 8 by extension</RadzenText>
                    </RadzenStack>
                        <RadzenChart Style="height:240px;overflow:visible">
                            <RadzenDonutSeries Data="@_fileTypeStats" CategoryProperty="Label" ValueProperty="Count"
                                               TItem="FileTypeStat" InnerRadius="60">
                                <TooltipTemplate Context="data">
                                    <div>
                                        <div style="font-weight:600;margin-bottom:2px">@data.Label</div>
                                        <div>@data.Count files</div>
                                        @if (_totalFileTypeCount > 0)
                                        {
                                            <div style="opacity:0.7;font-size:0.85em">@($"{(double)data.Count / _totalFileTypeCount * 100:F1}%")</div>
                                        }
                                    </div>
                                </TooltipTemplate>
                            </RadzenDonutSeries>
                        </RadzenChart>
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    }


    @if (_buckets.Count > 0)
    {
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6">Buckets</RadzenText>
                <div style="overflow-x:auto">
                <RadzenDataGrid Data="@_buckets" TItem="Bucket" AllowSorting="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="Bucket" Property="Name" Title="Name">
                            <Template Context="b">
                                <a href="/buckets/@b.Name" style="color:var(--rz-primary);text-decoration:none">@b.Name</a>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Bucket" Property="ObjectCount" Title="Objects">
                            <Template Context="b">@b.ObjectCount.ToString("N0")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Bucket" Property="TotalSize" Title="Size">
                            <Template Context="b">@FileHelper.FormatBytes(b.TotalSize)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Bucket" Title="Share" Sortable="false">
                            <Template Context="b">
                                @if (_totalSize > 0)
                                {
                                    var pct = (double)b.TotalSize / _totalSize * 100;
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <div style="flex:1;background:var(--rz-base-300);border-radius:4px;height:6px;overflow:hidden">
                                            <div style="width:@(pct.ToString("F1"))%;background:var(--rz-primary);height:100%"></div>
                                        </div>
                                        <span style="min-width:3rem;text-align:right;font-size:0.8rem">@pct.ToString("F1")%</span>
                                    </RadzenStack>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Bucket" Property="CreatedAt" Title="Created">
                            <Template Context="b">@b.CreatedAt.ToString("yyyy-MM-dd")</Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                </div>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

<style>
    .rz-data-grid-data td { height: 44px !important; padding-top: 0 !important; padding-bottom: 0 !important; }

    .stat-card {
        flex: 1;
        min-width: 140px;
        border-left: 3px solid var(--rz-primary);
    }
    .stat-icon {
        font-size: 1.4rem;
        color: var(--rz-primary);
        opacity: 0.8;
    }

</style>

@code {
    record FileTypeStat(string Label, int Count);

    List<Bucket> _buckets = [];
    List<Bucket> _topBySize = [];
    List<Bucket> _topByCount = [];
    List<FileTypeStat> _fileTypeStats = [];
    long _totalObjects;
    long _totalSize;
    int _totalFileTypeCount;
    DateTime _lastUpdated = DateTime.Now;
    Timer? _timer;
    string _currentUserId = string.Empty;
    bool _isPrivileged;
    StorageQuotaStatus? _myStorage;
    StorageSpaceStatus? _disk;
    static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(30);
    string? _fingerprint;
    int _polling;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _isPrivileged = auth.User.IsInRole("Admin") || auth.User.IsInRole("Manager");
        await LoadStats();
        _timer = new Timer(async _ =>
        {
            if (Interlocked.Exchange(ref _polling, 1) == 1) return;
            try
            {
                if (await LoadStats())
                    await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                // An unhandled exception in a Timer callback takes the whole process down.
                Logger.LogWarning(ex, "Dashboard refresh failed");
            }
            finally
            {
                Interlocked.Exchange(ref _polling, 0);
            }
        }, null, PollInterval, PollInterval);
    }

    // The bucket rows are few and change with every upload or delete, so they decide whether the GROUP BY over all objects runs at all.
    async Task<bool> LoadStats()
    {
        // Free space moves without any bucket changing, so the disk card carries its own change check.
        var disk = SpaceService.Get();
        var diskChanged = DiskLabel(disk) != DiskLabel(_disk);
        _disk = disk;

        var buckets = (await MetadataService.ListBucketsAsync(_isPrivileged ? null : _currentUserId)).OrderByDescending(b => b.TotalSize).ToList();
        var fingerprint = string.Join("|", buckets.Select(b => $"{b.Name}:{b.ObjectCount}:{b.TotalSize}:{b.UpdatedAt.Ticks}"));
        if (fingerprint == _fingerprint)
        {
            if (diskChanged) _lastUpdated = DateTime.Now;
            return diskChanged;
        }

        _fingerprint = fingerprint;
        _buckets = buckets;
        _myStorage = await QuotaService.GetAsync(_currentUserId);
        _totalObjects = _buckets.Sum(b => b.ObjectCount);
        _totalSize    = _buckets.Sum(b => b.TotalSize);
        _topBySize  = _buckets.Take(5).ToList();
        _topByCount = _buckets.OrderByDescending(b => b.ObjectCount).Take(5).ToList();

        var ownedBucketNames = _buckets.Select(b => b.Name).ToList();
        var contentTypeStats = (await MetadataService.GetContentTypeStatsAsync(ownedBucketNames)).ToList();

        _fileTypeStats = contentTypeStats
            .GroupBy(s => MimeToExtension(s.ContentType))
            .Select(g => new FileTypeStat(g.Key, g.Sum(s => s.Count)))
            .OrderByDescending(x => x.Count)
            .Take(8)
            .ToList();

        _totalFileTypeCount = _fileTypeStats.Sum(x => x.Count);
        _lastUpdated = DateTime.Now;
        return true;
    }

    // Only what the disk card renders, so the card refreshes when it would look different.
    static string DiskLabel(StorageSpaceStatus? disk) =>
        disk is null ? "" : $"{FileHelper.FormatBytes(disk.FreeBytes)}|{disk.IsBelowMinimum}|{disk.IsNearMinimum}";

    static string MimeToExtension(string contentType) => contentType switch
    {
        "application/pdf" => ".pdf",
        "application/zip" => ".zip",
        "application/gzip" => ".gz",
        "application/json" => ".json",
        "application/xml" => ".xml",
        "application/octet-stream" => "binary",
        "application/msword" => ".doc",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => ".docx",
        "application/vnd.ms-excel" => ".xls",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => ".xlsx",
        "application/vnd.ms-powerpoint" => ".ppt",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation" => ".pptx",
        "application/x-directory" => "folder",
        "text/plain" => ".txt",
        "text/html" => ".html",
        "text/css" => ".css",
        "text/csv" => ".csv",
        "text/markdown" => ".md",
        _ => contentType.Contains('/')
            ? "." + contentType[(contentType.LastIndexOf('/') + 1)..]
                .Replace("x-", "")
                .Split('+', ';')[0]
            : contentType
    };

    public void Dispose() => _timer?.Dispose();
}

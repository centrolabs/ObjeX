@page "/login"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject IHttpContextAccessor HttpContextAccessor
@inject PersistentComponentState ApplicationState
@implements IDisposable

<PageTitle>Login — ObjeX</PageTitle>

<div style="display:flex; align-items:center; justify-content:center; min-height:100vh; background:var(--rz-base-background-color)">
    <RadzenCard Style="width:400px">
        <RadzenStack Gap="1.5rem">
            <RadzenStack Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.H5" style="margin:0">ObjeX</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">Self-hosted blob storage</RadzenText>
            </RadzenStack>

            <form method="post" action="/account/login">
                <RadzenStack Gap="0.75rem">
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                    <RadzenStack Gap="0.25rem">
                        <RadzenLabel Text="Email or username" />
                        <input class="rz-textbox" style="width:100%" type="text"
                               name="login" value="@LoginValue" placeholder="admin@objex.local" autocomplete="username" />
                    </RadzenStack>

                    <RadzenStack Gap="0.25rem">
                        <RadzenLabel Text="Password" />
                        <input class="rz-textbox" style="width:100%" type="password"
                               name="password" autocomplete="current-password" />
                    </RadzenStack>

                    <label style="display:flex; align-items:center; gap:0.5rem; font-size:0.875rem; cursor:pointer">
                        <input type="checkbox" name="rememberMe" value="true" checked="@_remember" />
                        Stay signed in
                    </label>

                    <button type="submit" class="rz-button rz-button-md rz-primary" style="width:100%">
                        Sign in
                    </button>
                </RadzenStack>
            </form>

        </RadzenStack>
    </RadzenCard>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Msg { get; set; }
    [SupplyParameterFromQuery(Name = "login")] public string? LoginValue { get; set; }

    bool _remember;
    PersistingComponentStateSubscription _persisting;

    protected override async Task OnInitializedAsync()
    {
        // The cookie is only readable while prerendering; the interactive circuit restores the value from the persisted state.
        _persisting = ApplicationState.RegisterOnPersisting(() =>
        {
            ApplicationState.PersistAsJson(nameof(_remember), _remember);
            return Task.CompletedTask;
        });
        _remember = ApplicationState.TryTakeFromJson<bool>(nameof(_remember), out var restored)
            ? restored
            : HttpContextAccessor.HttpContext?.Request.Cookies["objex-remember"] == "1";

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Error == "1")
        {
            var message = !string.IsNullOrWhiteSpace(Msg) ? Msg : "Invalid username/email or password.";
            NotificationService.Notify(NotificationSeverity.Error, "Login failed", message);
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => _persisting.Dispose();
}

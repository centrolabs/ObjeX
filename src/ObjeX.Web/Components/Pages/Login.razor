@page "/login"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject IHttpContextAccessor HttpContextAccessor
@inject PersistentComponentState ApplicationState
@implements IDisposable

<PageTitle>Login — ObjeX</PageTitle>

<OxContainer Narrow="true">
    <OxStack Gap="2">
        <OxBrand />
        <OxText Variant="OxTextVariant.Muted">Self-hosted blob storage</OxText>
    </OxStack>

    <OxCard>
        <form method="post" action="/account/login">
            <OxStack Gap="7">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <OxField Label="Email or username">
                    <OxTextInput name="login" Value="@LoginValue" Placeholder="admin@objex.local" autocomplete="username" AutoFocus="true" />
                </OxField>

                <OxField Label="Password">
                    <OxTextInput Type="password" name="password" autocomplete="current-password" />
                </OxField>

                <OxCheckbox name="rememberMe" value="true" Checked="@_remember" CheckedChanged="@(v => _remember = v)">Stay signed in</OxCheckbox>

                <OxButton Type="submit" Variant="OxButtonVariant.Primary" Block="true">Sign in</OxButton>
            </OxStack>
        </form>
    </OxCard>
</OxContainer>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Msg { get; set; }
    [SupplyParameterFromQuery(Name = "login")] public string? LoginValue { get; set; }

    bool _remember;
    PersistingComponentStateSubscription _persisting;

    protected override async Task OnInitializedAsync()
    {
        // The cookie is only readable while prerendering; the interactive circuit restores the value from the persisted state.
        _persisting = ApplicationState.RegisterOnPersisting(() =>
        {
            ApplicationState.PersistAsJson(nameof(_remember), _remember);
            return Task.CompletedTask;
        });
        _remember = ApplicationState.TryTakeFromJson<bool>(nameof(_remember), out var restored)
            ? restored
            : HttpContextAccessor.HttpContext?.Request.Cookies["objex-remember"] == "1";

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Error == "1")
        {
            var message = !string.IsNullOrWhiteSpace(Msg) ? Msg : "Invalid username/email or password.";
            NotificationService.Notify(NotificationSeverity.Error, "Login failed", message);
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => _persisting.Dispose();
}

@page "/buckets/{BucketName}"
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Antiforgery
@using ObjeX.Core.Interfaces
@using ObjeX.Core.Models
@using ObjeX.Web.Components.Dialogs
@using ObjeX.Infrastructure.Data
@using ObjeX.Core.Utilities
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ObjeX.Infrastructure.Options
@inject IMetadataService MetadataService
@inject IObjectStorageService StorageService
@inject ILogger<Objects> Logger
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject IOptions<S3Options> S3
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<ObjeXDbContext> DbFactory
@inject IJSRuntime JS
@inject BrowserTimeZone Tz
@inject AntiforgeryStateProvider Antiforgery
@inject IKeyGate KeyGate
@inject IOptions<AntiforgeryOptions> AntiforgeryOptions

<PageTitle>@(UploadText.TabPrefix(_uploads) is { } progress ? $"{progress} · " : null)@BucketName — ObjeX</PageTitle>

<NavigationLock ConfirmExternalNavigation="@_uploads.IsActive" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<OxDropZone Sink="_uploader">
    <OxPageHeader Meta="@(_bucket is null ? null : HeaderCaption)">
        <Heading><OxBreadcrumbs Items="@Crumbs" /></Heading>
        <ChildContent>
            @* During a selection the search stays only while it filters, so its clear button stays reachable without crowding the line. *@
            @if (_bucketExists && _bucket is { ObjectCount: > 0 } && (_selected.Count == 0 || _searchTerm.Length > 0))
            {
                <OxSearch Value="@_searchTerm" ValueChanged="OnSearchInput" OnClear="ClearSearch" Tooltip="* matches any text, ? one character" />
            }
            @* A selection swaps the create actions for the selection actions on the same line, so the table never moves. *@
            @if (_selected.Count > 0)
            {
                <OxSelectionBar Count="@_selected.Count" OnClear="@(() => _selected.Clear())">
                    <OxButton Icon="download" OnClick="BulkDownload" Busy="@_bulkDownloading">Download ZIP</OxButton>
                    <OxButton Variant="OxButtonVariant.Danger" Icon="delete" OnClick="BulkDelete" Busy="@_bulkDeleting">Delete</OxButton>
                </OxSelectionBar>
            }
            else
            {
                <OxButton Icon="create_new_folder" Disabled="@(!_bucketExists)" OnClick="OnNewFolderClick">New folder</OxButton>
                <OxButton Variant="OxButtonVariant.Primary" Icon="upload" Disabled="@(!_bucketExists || _uploader is null)" OnClick="OnUploadClick">Upload</OxButton>
            }
        </ChildContent>
    </OxPageHeader>

    <RadzenDataGrid @ref="_grid" Data="@_rows" TItem="ListRow" AllowSorting="true" AllowAlternatingRows="false" RowRender="OnRowRender"
                    EmptyText="@(_searchApplied ? "No matches." : "No objects yet. Drag files or folders here or click Upload.")">
        <Columns>
            <RadzenDataGridColumn TItem="ListRow" Width="@OxSizes.CheckColumn" Sortable="false" Resizable="false" CssClass="ox-col-check">
                <HeaderTemplate>
                    <OxCheckbox Label="Select all" Checked="@(_rows.Count > 0 && _selected.Count == _rows.Count)"
                                CheckedChanged="@(v => { if (v) _rows.ForEach(r => _selected.Add(r)); else _selected.Clear(); })" />
                </HeaderTemplate>
                <Template Context="row">
                    <OxCheckbox Label="@($"Select {row.Name}")" Checked="@_selected.Contains(row)" OnClick="@(e => OnCheckClick(row, e))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ListRow" Title="Name" Property="Name">
                <Template Context="row">
                    @if (row.IsFolder)
                    {
                        <OxFileName Kind="OxFileKind.Folder" Href="@PrefixUrl(row.FolderPath!)">@row.Name</OxFileName>
                    }
                    else
                    {
                        <OxFileName Kind="@OxFileIcon.KindOf(row.Object!.ContentType)">@row.Name</OxFileName>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ListRow" Title="Type" Property="SortContentType" Width="@OxSizes.TypeColumn" CssClass="ox-col-muted">
                <Template Context="row">@(row.IsFolder ? "—" : row.Object!.ContentType)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ListRow" Title="Size" Property="SortSize" Width="@OxSizes.SizeColumn" TextAlign="TextAlign.End">
                <Template Context="row">@(row.IsFolder ? "—" : FileHelper.FormatBytes(row.Object!.Size))</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ListRow" Title="Modified" Property="SortDate" Width="@OxSizes.DateColumn" CssClass="ox-col-muted">
                <Template Context="row">@if (row.IsFolder) { @("—") } else { <OxTime Value="@row.Object!.UpdatedAt" /> }</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ListRow" Title="" Width="@OxSizes.ActionsColumn" Sortable="false" Resizable="false" CssClass="ox-col-actions">
                <Template Context="row">
                    <OxRowActions>
                        @if (row.IsFolder)
                        {
                            <OxMenuButton Label="@($"More actions for {row.Name}")">
                                <OxMenuItem Icon="download" Href="@FileHelper.FolderZipUrl(BucketName, row.FolderPath!)" Download="@($"{row.Name[..^1]}.zip")">Download ZIP</OxMenuItem>
                                <OxMenuDivider />
                                <OxMenuItem Icon="delete" Danger="true" OnClick="@(() => OnDeleteFolder(row.FolderPath!))">Delete</OxMenuItem>
                            </OxMenuButton>
                        }
                        else
                        {
                            var obj = row.Object!;
                            <OxIconButton Icon="download" Label="Download" Href="@FileHelper.ObjectUrl(BucketName, obj.Key, download: true)"
                                          Download="@Path.GetFileName(obj.Key)" target="_blank" />
                            <OxIconButton Icon="link" Label="Share link" OnClick="@(() => CopyPresignedLink(obj))" />
                            <OxMenuButton Label="@($"More actions for {row.Name}")">
                                @if (IsPreviewable(obj.ContentType))
                                {
                                    <OxMenuItem Icon="visibility" OnClick="@(() => PreviewObject(obj))">Preview</OxMenuItem>
                                }
                                <OxMenuItem Icon="info" OnClick="@(() => ShowMetadata(obj))">Metadata</OxMenuItem>
                                <OxMenuItem Icon="content_copy" OnClick="@(() => CopyText(obj.Key, "Key copied"))">Copy key</OxMenuItem>
                                <OxMenuItem Icon="content_copy" OnClick="@(() => CopyText($"s3://{BucketName}/{obj.Key}", "S3 URI copied"))">Copy S3 URI</OxMenuItem>
                                <OxMenuDivider />
                                <OxMenuItem Icon="delete" Danger="true" OnClick="@(() => OnDeleteObject(obj))">Delete</OxMenuItem>
                            </OxMenuButton>
                        }
                    </OxRowActions>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    @if (_uploads.Items.Count > 0)
    {
        <OxUploadPanel Title="@UploadText.Title(_uploads)" Detail="@UploadText.Detail(_uploads)" Progress="@_uploads.Percent" Tone="@UploadText.Tone(_uploads)">
            <Actions>
                @if (_uploads.IsActive)
                {
                    <OxIconButton Icon="cancel" Label="Cancel all" OnClick="CancelAllUploads" />
                }
                else
                {
                    @if (_uploads.Items.Any(i => i.CanRetry))
                    {
                        <OxIconButton Icon="refresh" Label="Retry failed" OnClick="@(() => RetryUploads(null))" />
                    }
                    <OxIconButton Icon="close" Label="Close" OnClick="CloseUploads" />
                }
            </Actions>
            <ChildContent>
                <Virtualize Items="_uploads.Items" Context="item" ItemSize="60">
                    <OxUploadRow Name="@item.Name" Kind="@OxFileIcon.KindOf(item.ContentType)" Detail="@UploadText.Row(item)"
                                 Tone="@UploadText.RowTone(item)" Progress="@UploadText.RowProgress(item)">
                        @if (item.Status is UploadStatus.Queued or UploadStatus.Uploading)
                        {
                            <OxIconButton Icon="close" Label="@($"Cancel {item.Name}")" OnClick="@(() => CancelUpload(item.Id))" />
                        }
                        else if (item.CanRetry)
                        {
                            <OxIconButton Icon="refresh" Label="@($"Retry {item.Name}")" OnClick="@(() => RetryUploads(item.Id))" />
                        }
                        else if (item.Status == UploadStatus.Done)
                        {
                            <OxIcon Name="check_circle" Tone="OxTone.Accent" />
                        }
                    </OxUploadRow>
                </Virtualize>
            </ChildContent>
        </OxUploadPanel>
    }
</OxDropZone>

@code {
    [Parameter] public string BucketName { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "prefix")] public string? PrefixParam { get; set; }

    record ListRow(string Name, bool IsFolder, string? FolderPath = null, BlobObject? Object = null)
    {
        public string SortContentType => Object?.ContentType ?? string.Empty;
        public long   SortSize        => Object?.Size        ?? 0;
        public DateTime SortDate      => Object?.UpdatedAt   ?? DateTime.MinValue;
    }

    List<ListRow> _rows = [];
    List<BlobObject> _objects = [];
    List<string> _folders = [];
    HashSet<ListRow> _selected = [];
    RadzenDataGrid<ListRow>? _grid;
    ListRow? _selectionAnchor;
    IJSObjectReference? _paste;
    string _currentPrefix = string.Empty;
    readonly UploadQueue _uploads = new();
    IJSObjectReference? _uploadModule;
    IJSObjectReference? _uploader;
    DotNetObjectReference<Objects>? _self;
    DateTime _uploadsListedAt;
    bool _bucketExists = true;
    bool _bulkDeleting;
    bool _bulkDownloading;
    Bucket? _bucket;
    string? _loadedPrefix;
    string _currentUserId = string.Empty;
    bool _isPrivileged;
    string _searchTerm = string.Empty;
    bool _searchApplied;
    bool _searchLimitHit;
    CancellationTokenSource _searchCts = new();

    const int SearchLimit = 500;
    const int SearchDebounceMs = 300;
    static readonly TimeSpan UploadRefreshInterval = TimeSpan.FromSeconds(3);

    string HeaderCaption =>
        _searchApplied
            ? _searchLimitHit
                ? $"{_rows.Count:N0} results · first {SearchLimit} shown"
                : $"{_rows.Count:N0} results"
            : $"{_bucket!.ObjectCount:N0} objects · {FileHelper.FormatBytes(_bucket.TotalSize)}";

    IReadOnlyList<OxCrumb> Crumbs =>
    [
        new("Buckets", "/buckets"),
        new(BucketName, PrefixUrl(string.Empty)),
        ..GetBreadcrumbSegments().Select(c => new OxCrumb(c.Segment, PrefixUrl(c.PrefixUpTo)))
    ];

    // What the grid shows, in its order: a sorted grid differs from _rows, and Shift-click and preview paging follow the screen.
    List<ListRow> VisibleRows() => _grid?.View?.ToList() ?? _rows;

    void OnCheckClick(ListRow row, MouseEventArgs e) =>
        _selectionAnchor = RangeSelection.Apply(VisibleRows(), _selected, _selectionAnchor, row, e.ShiftKey);

    void OnRowRender(RowRenderEventArgs<ListRow> args)
    {
        if (args.Data is not null && _selected.Contains(args.Data))
            args.Attributes["class"] = OxSizes.SelectedRowClass;
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _isPrivileged = auth.User.IsInRole("Admin") || auth.User.IsInRole("Manager");

        _currentPrefix = PrefixParam ?? string.Empty;
        _bucket = await MetadataService.GetBucketAsync(BucketName, _isPrivileged ? null : _currentUserId);
        _bucketExists = _bucket is not null;
        if (_bucketExists)
            await LoadObjects();
        else
            NotificationService.Notify(NotificationSeverity.Error, "Bucket not found", $"\"{BucketName}\" does not exist.");
    }

    async Task LoadObjects()
    {
        _loadedPrefix = _currentPrefix;
        // Bucket stats change with every upload and delete, so refresh them together with the listing.
        _bucket = await MetadataService.GetBucketAsync(BucketName, _isPrivileged ? null : _currentUserId);
        var result = await MetadataService.ListObjectsAsync(
            BucketName,
            prefix: string.IsNullOrEmpty(_currentPrefix) ? null : _currentPrefix,
            delimiter: "/");
        _objects = result.Objects.ToList();
        _folders = result.CommonPrefixes.ToList();

        // The search box is gone once the bucket is empty, so a term left over from a delete would be unclearable.
        if (_bucket is null or { ObjectCount: 0 })
            _searchTerm = string.Empty;

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            ShowFolderView();
        }
        else
        {
            // A keystroke during the refresh cancels it; that keystroke renders its own result.
            try { await RunSearch(_searchCts.Token); }
            catch (OperationCanceledException) { }
        }
    }

    void BuildFolderRows() =>
        _rows = [
            .._folders.Select(f => new ListRow(f[_currentPrefix.Length..].TrimEnd('/') + "/", true, f)),
            .._objects.Where(o => !o.Key.EndsWith("/")).Select(o => new ListRow(o.Key[_currentPrefix.Length..], false, Object: o))
        ];

    async Task RunSearch(CancellationToken ctk)
    {
        // One row over the limit tells the caption whether the result set was cut off.
        var hits = await MetadataService.SearchObjectsAsync(BucketName, _currentPrefix, _searchTerm, SearchLimit + 1, ctk);
        _searchLimitHit = hits.Count > SearchLimit;
        _rows = hits.Take(SearchLimit).Select(o => new ListRow(o.Key[_currentPrefix.Length..], false, Object: o)).ToList();
        _selected.Clear();
        _searchApplied = true;
    }

    async Task OnSearchInput(string value)
    {
        _searchTerm = value;
        // Blazor serialises handlers on its dispatcher, so replacing the source cannot race with the awaiting keystroke.
        _searchCts.Cancel();
        _searchCts = new CancellationTokenSource();
        var ctk = _searchCts.Token;

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            ShowFolderView();
            return;
        }

        try
        {
            await Task.Delay(SearchDebounceMs, ctk);
            await RunSearch(ctk);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    void ClearSearch()
    {
        _searchTerm = string.Empty;
        ShowFolderView();
    }

    // Cancels the pending debounce too, so a stale keystroke cannot re-apply the search afterwards.
    void ShowFolderView()
    {
        _searchCts.Cancel();
        _searchCts = new CancellationTokenSource();
        if (_searchApplied) _selected.Clear();
        _searchApplied = false;
        _searchLimitHit = false;
        BuildFolderRows();
    }

    // Folders are links, so each one is a history entry; OnParametersSetAsync does the loading and Back and Forward work the same way.
    string PrefixUrl(string prefix) =>
        string.IsNullOrEmpty(prefix)
            ? $"/buckets/{BucketName}"
            : $"/buckets/{BucketName}?prefix={Uri.EscapeDataString(prefix)}";

    protected override async Task OnParametersSetAsync()
    {
        var prefix = PrefixParam ?? string.Empty;
        if (!_bucketExists || prefix == _loadedPrefix) return;

        _selected.Clear();
        _searchTerm = string.Empty;
        _currentPrefix = prefix;
        await LoadObjects();
    }

    IEnumerable<(string Segment, string PrefixUpTo)> GetBreadcrumbSegments()
    {
        if (string.IsNullOrEmpty(_currentPrefix)) yield break;
        var parts = _currentPrefix.TrimEnd('/').Split('/');
        for (var i = 0; i < parts.Length; i++)
            yield return (parts[i], string.Join("/", parts[..(i + 1)]) + "/");
    }

    async Task OnNewFolderClick()
    {
        var name = await DialogService.OpenAsync<Dialogs.CreateFolderDialog>("New folder", options: new DialogOptions { Width = OxSizes.DialogSmall, CloseDialogOnOverlayClick = true });
        if (name is not string folderName || string.IsNullOrWhiteSpace(folderName)) return;

        var key = _currentPrefix + folderName.Trim('/') + "/";
        try
        {
            using var gate = await KeyGate.EnterAsync(BucketName, [key]);
            await using var empty = new MemoryStream();
            await using var hashingStream = new Core.Utilities.HashingStream(empty);
            var storagePath = await StorageService.StoreAsync(BucketName, key, hashingStream);
            await MetadataService.SaveObjectAsync(new BlobObject
            {
                BucketName = BucketName,
                Key = key,
                Size = 0,
                ContentType = "application/x-directory",
                ETag = hashingStream.GetETag(),
                StoragePath = storagePath
            }, _currentUserId);
            await LoadObjects();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to create folder", ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_bucketExists || Antiforgery.GetAntiforgeryToken()?.Value is not { } token) return;
        _self = DotNetObjectReference.Create(this);
        _uploadModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ObjeX.Web/Components/Pages/Objects.razor.js");
        _uploader = await _uploadModule.InvokeAsync<IJSObjectReference>("createUploader", _self, AntiforgeryOptions.Value.HeaderName, token);
        _paste = await _uploadModule.InvokeAsync<IJSObjectReference>("watchPaste", _uploader);
        StateHasChanged();
    }

    async Task OnUploadClick()
    {
        if (await MetadataService.GetBucketAsync(BucketName, _isPrivileged ? null : _currentUserId) is null)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Bucket not found", $"\"{BucketName}\" no longer exists.");
            return;
        }

        await DialogService.OpenAsync<UploadObjectDialog>("Upload",
            new Dictionary<string, object?> { { nameof(UploadObjectDialog.Uploader), _uploader } },
            new DialogOptions { Width = OxSizes.DialogMedium, CloseDialogOnOverlayClick = true });
    }

    // Files dropped or picked: the key is fixed under the folder shown when the drop's first batch came, so changing folders later moves nothing.
    [JSInvokable]
    public async Task OnFilesAdded(int drop, UploadFile[] files)
    {
        var toSend = _uploads.Add(drop, _currentPrefix, files);
        StateHasChanged();
        await StartUploadsAsync(toSend);
    }

    [JSInvokable]
    public async Task OnUploadEvents(UploadEvent[] events)
    {
        var wasActive = _uploads.IsActive;
        _uploads.Apply(events);
        var finished = wasActive && !_uploads.IsActive;

        // A refresh rebuilds the rows and would drop a selection in progress, so while files arrive it waits for none.
        if (finished || (_selected.Count == 0 && events.Any(e => e.Kind == "done") && DateTime.UtcNow - _uploadsListedAt > UploadRefreshInterval))
        {
            _uploadsListedAt = DateTime.UtcNow;
            await LoadObjects();
        }

        if (finished)
        {
            var missed = _uploads.CountOf(UploadStatus.Failed) + _uploads.CountOf(UploadStatus.Cancelled);
            NotificationService.Notify(missed == 0 ? NotificationSeverity.Success : NotificationSeverity.Warning,
                UploadText.Title(_uploads), missed == 0 ? "" : UploadText.Detail(_uploads));
        }
        StateHasChanged();
    }

    Task StartUploadsAsync(IReadOnlyList<UploadItem> items) =>
        items.Count == 0 || _uploader is null
            ? Task.CompletedTask
            : _uploader.InvokeVoidAsync("start", items.Select(i => new { id = i.Id, url = FileHelper.UploadUrl(BucketName, i.Key), type = i.ContentType })).AsTask();

    async Task CancelUpload(int id)
    {
        if (_uploader is not null) await _uploader.InvokeVoidAsync("cancel", id);
    }

    async Task CancelAllUploads()
    {
        if (_uploader is not null) await _uploader.InvokeVoidAsync("cancelAll");
    }

    Task RetryUploads(int? id) => StartUploadsAsync(_uploads.Retry(id));

    async Task CloseUploads()
    {
        var ids = _uploads.Clear();
        if (_uploader is not null) await _uploader.InvokeVoidAsync("forget", ids);
    }

    // Another folder of this bucket keeps the page and its uploads; any other page ends them.
    async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!_uploads.IsActive || Navigation.ToBaseRelativePath(context.TargetLocation).Split('?', '#')[0] == $"buckets/{BucketName}")
            return;

        if (!await ConfirmDialog.AskAsync(DialogService, "Leave page", UploadText.LeaveQuestion(_uploads), "Leave", danger: true))
            context.PreventNavigation();
        else
            await CancelAllUploads();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_paste is not null)
            {
                await _paste.InvokeVoidAsync("stop");
                await _paste.DisposeAsync();
            }
            if (_uploader is not null)
            {
                await _uploader.InvokeVoidAsync("dispose");
                await _uploader.DisposeAsync();
            }
            if (_uploadModule is not null) await _uploadModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }

    async Task OnDeleteFolder(string folderPath)
    {
        if (!await ConfirmDialog.AskAsync(DialogService, "Delete folder", $"Delete \"{folderPath.TrimEnd('/')}\" and all its contents?", "Delete", danger: true)) return;

        try
        {
            var result = await MetadataService.ListObjectsAsync(BucketName, prefix: folderPath, delimiter: null);
            await DeleteObjectsAsync(result.Objects.Select(o => o.Key).ToList());
            await LoadObjects();
            NotificationService.Notify(NotificationSeverity.Success, "Folder deleted", folderPath.TrimEnd('/'));
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to delete folder", ex.Message);
        }
    }

    async Task OnDeleteObject(BlobObject obj)
    {
        if (!await ConfirmDialog.AskAsync(DialogService, "Delete object", $"Delete \"{obj.Key}\"?", "Delete", danger: true)) return;

        try
        {
            await DeleteObjectAsync(obj.Key);
            await LoadObjects();
            NotificationService.Notify(NotificationSeverity.Success, "Object deleted", obj.Key);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to delete object", ex.Message);
        }
    }

    async Task BulkDelete()
    {
        if (_bulkDeleting) return;
        var count = _selected.Count;
        if (!await ConfirmDialog.AskAsync(DialogService, "Delete selection", $"Delete {count} selected item(s)? This cannot be undone.", "Delete", danger: true)) return;

        _bulkDeleting = true;
        try
        {
            await DeleteSelectionAsync(count);
        }
        finally
        {
            _bulkDeleting = false;
        }
    }

    async Task DeleteSelectionAsync(int count)
    {
        var errors = new List<string>();
        try
        {
            var keys = new List<string>();
            foreach (var row in _selected.ToList())
            {
                if (row.IsFolder)
                {
                    var result = await MetadataService.ListObjectsAsync(BucketName, prefix: row.FolderPath!, delimiter: null);
                    keys.AddRange(result.Objects.Select(o => o.Key));
                }
                else
                {
                    keys.Add(row.Object!.Key);
                }
            }
            await DeleteObjectsAsync(keys);
        }
        catch (Exception ex) { errors.Add(ex.Message); }

        _selected.Clear();
        await LoadObjects();

        if (errors.Count == 0)
            NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"{count} item(s) deleted.");
        else
            foreach (var err in errors)
                NotificationService.Notify(NotificationSeverity.Error, "Delete failed", err);
    }

    async Task BulkDownload()
    {
        if (_bulkDownloading) return;
        _bulkDownloading = true;
        try
        {
            // Listing large folders takes a moment before the browser shows the download; the spin covers it.
            await Task.WhenAll(DownloadSelectionAsync(), Task.Delay(OxMotion.SpinTurn));
        }
        finally
        {
            _bulkDownloading = false;
        }
    }

    async Task DownloadSelectionAsync()
    {
        var allKeys = new List<string>();

        foreach (var row in _selected)
        {
            if (row.IsFolder)
            {
                var result = await MetadataService.ListObjectsAsync(BucketName, prefix: row.FolderPath!, delimiter: null);
                allKeys.AddRange(result.Objects.Where(o => !o.Key.EndsWith("/")).Select(o => o.Key));
            }
            else
            {
                allKeys.Add(row.Object!.Key);
            }
        }

        if (allKeys.Count == 0) return;

        var query = string.Join("&", allKeys.Select(k => $"keys={Uri.EscapeDataString(k)}"));
        var url = $"/api/objects/{BucketName}/download?{query}";
        await JS.InvokeVoidAsync("ObjeX.triggerDownload", url, "selection.zip");
        _selected.Clear();
    }

    async Task ShowMetadata(BlobObject obj)
    {
        await DialogService.OpenAsync<Dialogs.FileMetadataDialog>(
            Path.GetFileName(obj.Key),
            new Dictionary<string, object?>
            {
                { "Key",         obj.Key },
                { "ContentType", obj.ContentType },
                { "Size",        obj.Size },
                { "ETag",        obj.ETag },
                { "CreatedAt",   obj.CreatedAt },
                { "UpdatedAt",   obj.UpdatedAt },
                { "CustomMetadataJson", obj.CustomMetadata },
            },
            new DialogOptions { Width = OxSizes.DialogMedium, CloseDialogOnOverlayClick = true, ShowClose = true });
    }

    // Row first, blob second: a row must never point at a missing blob, while a leftover blob is collected by the orphan cleanup job.
    // Behind the key gate, so an upload of the key cannot put its file between the two.
    async Task DeleteObjectAsync(string key)
    {
        using var gate = await KeyGate.EnterAsync(BucketName, [key]);
        await MetadataService.DeleteObjectAsync(BucketName, key, _currentUserId);
        await DeleteBlobAsync(key);
    }

    // The rows go in one transaction and one stats update; the blobs stay per file.
    async Task DeleteObjectsAsync(IReadOnlyCollection<string> keys)
    {
        if (keys.Count == 0) return;
        using var gate = await KeyGate.EnterAsync(BucketName, keys);
        await MetadataService.DeleteObjectsAsync(BucketName, keys, _currentUserId);
        foreach (var key in keys)
            await DeleteBlobAsync(key);
    }

    async Task DeleteBlobAsync(string key)
    {
        try
        {
            await StorageService.DeleteAsync(BucketName, key);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Blob {Bucket}/{Key} could not be deleted and is left for the orphan cleanup job", BucketName, key);
        }
    }

    // SVG can carry script, so the download endpoint never serves it inline and the preview would show a broken image.
    static bool IsPreviewable(string contentType) =>
        InlineMediaTypes.IsInlineSafe(contentType) || TextPreview.IsTextLike(contentType);

    // The dialog pages with the arrow keys through the previewable files of the list, in the order on screen.
    async Task PreviewObject(BlobObject obj)
    {
        var items = VisibleRows()
            .Where(r => r.Object is { } o && IsPreviewable(o.ContentType))
            .Select(r => new Dialogs.FilePreviewDialog.Item(r.Object!.Key, r.Object.ContentType))
            .ToList();
        var index = items.FindIndex(i => i.Key == obj.Key);
        if (index < 0)
        {
            items = [new(obj.Key, obj.ContentType)];
            index = 0;
        }

        await DialogService.OpenAsync<Dialogs.FilePreviewDialog>(
            "Preview",
            new Dictionary<string, object?>
            {
                { "BucketName", BucketName },
                { "Items",      items },
                { "Index",      index },
            },
            new DialogOptions { Width = OxSizes.DialogLarge, CloseDialogOnOverlayClick = true, ShowClose = true });
    }

    async Task CopyText(string text, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            NotificationService.Notify(NotificationSeverity.Success, message);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Copy failed", ex.Message);
        }
    }

    async Task CopyPresignedLink(BlobObject obj)
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        S3Credential? credential;
        int defaultExpiry, maxExpiry;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            credential = await db.S3Credentials.AsNoTracking()
                .Where(c => c.UserId == userId)
                .OrderBy(c => c.CreatedAt)
                .FirstOrDefaultAsync();

            var settings  = await db.SystemSettings.FindAsync(1);
            defaultExpiry = settings?.PresignedUrlDefaultExpirySeconds ?? 3600;
            maxExpiry     = settings?.PresignedUrlMaxExpirySeconds ?? 604800;
        }

        if (credential is null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "No S3 credential", "Create one in Settings first.");
            return;
        }

        var result = await DialogService.OpenAsync<Dialogs.PresignedUrlDialog>(
            "Share link",
            new Dictionary<string, object?>
            {
                { "DefaultSeconds", defaultExpiry },
                { "MaxSeconds",     maxExpiry },
                { "CredentialName", credential.Name },
            },
            new DialogOptions { Width = OxSizes.DialogSmall, CloseDialogOnOverlayClick = true });

        if (result is not int expiresSeconds) return;

        var url = PresignedUrlGenerator.Generate(
            S3.Value.PublicUrl, BucketName, obj.Key,
            credential.AccessKeyId, credential.SecretAccessKey,
            expiresSeconds);

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);

        NotificationService.Notify(NotificationSeverity.Success, "Link copied",
            $"Expires at {Tz.FormatSeconds(DateTime.UtcNow.AddSeconds(expiresSeconds))}");
    }
}

@inject DialogService DialogService

<OxStack Gap="8" @onkeydown="OnKeyDown" tabindex="-1">
    <OxAlert Tone="OxTone.Warning">Save your secret access key now — it won't be shown again.</OxAlert>

    <OxStack Gap="3">
        <OxText Variant="OxTextVariant.Label">Access key ID</OxText>
        <OxCode Text="@AccessKeyId" Copyable="true" />
    </OxStack>

    <OxStack Gap="3">
        <OxText Variant="OxTextVariant.Label">Secret access key</OxText>
        <OxCode Text="@SecretAccessKey" Copyable="true" />
    </OxStack>

    <S3ConnectSnippets Endpoint="@Endpoint" AccessKeyId="@AccessKeyId" SecretAccessKey="@SecretAccessKey" />

    <OxStack Row="true" Justify="OxJustify.End">
        <OxButton Variant="OxButtonVariant.Primary" OnClick="@(() => DialogService.Close(null))">Done</OxButton>
    </OxStack>
</OxStack>

@code {
    [Parameter] public string AccessKeyId { get; set; } = string.Empty;
    [Parameter] public string SecretAccessKey { get; set; } = string.Empty;
    [Parameter] public string Endpoint { get; set; } = string.Empty;

    void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") DialogService.Close(null);
    }
}

@inject DialogService DialogService

<OxStack Gap="8">
    <OxField Label="Folder name" Error="@_error" ReserveError="true">
        <OxTextInput @bind-Value="_name" Placeholder="e.g. photos" AutoFocus="true" Invalid="@(_error is not null)"
                     OnEnter="OnCreate" OnEscape="@(() => DialogService.Close(null))" />
    </OxField>
    <OxStack Row="true" Justify="OxJustify.End" Gap="4">
        <OxButton OnClick="@(() => DialogService.Close(null))">Cancel</OxButton>
        <OxButton Variant="OxButtonVariant.Primary" Disabled="@string.IsNullOrWhiteSpace(_name)" OnClick="OnCreate">Create</OxButton>
    </OxStack>
</OxStack>

@code {
    string _name = string.Empty;
    string? _error;

    void OnCreate()
    {
        var name = _name.Trim().Trim('/');
        if (string.IsNullOrEmpty(name)) { _error = "Folder name cannot be empty."; return; }
        if (name.Contains('/')) { _error = "Use the UI to nest folders — no slashes allowed here."; return; }
        DialogService.Close(name);
    }
}

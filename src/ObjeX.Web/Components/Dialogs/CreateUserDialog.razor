@inject DialogService DialogService

<OxStack Gap="6">
    <OxField Label="Username" Error="@_usernameError" ReserveError="true">
        <OxTextInput Value="@_username" ValueChanged="OnUsernameInput" Placeholder="e.g. jsmith" AutoFocus="true" Invalid="@(_usernameError is not null)"
                     OnEnter="OnEnter" OnEscape="@(() => DialogService.Close(null))" />
    </OxField>
    <OxField Label="Email" Error="@_emailError" ReserveError="true">
        <OxTextInput Type="email" Value="@_email" ValueChanged="OnEmailInput" Placeholder="user@example.com" Invalid="@(_emailError is not null)"
                     OnEnter="OnEnter" OnEscape="@(() => DialogService.Close(null))" />
    </OxField>
    <OxField Label="Role">
        <RadzenDropDown @bind-Value="_role" Data="_roles" />
    </OxField>
    <OxStack Row="true" Justify="OxJustify.End" Gap="4">
        <OxButton OnClick="@(() => DialogService.Close(null))">Cancel</OxButton>
        <OxButton Variant="OxButtonVariant.Primary" Disabled="@(!IsValid)" OnClick="OnCreate">Create</OxButton>
    </OxStack>
</OxStack>

@code {
    string _username = string.Empty;
    string _email = string.Empty;
    string _role = "User";
    string? _usernameError;
    string? _emailError;

    static readonly string[] _roles = ["User", "Manager"];

    public record Result(string Username, string Email, string Role);

    bool IsValid => _usernameError is null && _emailError is null
        && !string.IsNullOrWhiteSpace(_username) && !string.IsNullOrWhiteSpace(_email);

    void OnUsernameInput(string value)
    {
        _username = value;
        if (string.IsNullOrWhiteSpace(_username))
            _usernameError = "Username is required.";
        else if (!_username.All(c => char.IsLetterOrDigit(c) || c == '_' || c == '-'))
            _usernameError = "Only letters, numbers, underscores and hyphens allowed.";
        else
            _usernameError = null;
    }

    void OnEmailInput(string value)
    {
        _email = value;
        try { _ = new System.Net.Mail.MailAddress(_email); _emailError = null; }
        catch { _emailError = "Enter a valid email address."; }
    }

    void OnEnter()
    {
        if (IsValid) OnCreate();
    }

    void OnCreate() => DialogService.Close(new Result(_username.Trim(), _email.Trim(), _role));
}

@using ObjeX.Core.Interfaces
@using ObjeX.Core.Utilities

<OxStack Gap="7">
    @if (Kind is { } kind)
    {
        <OxPreview Kind="@kind" Url="@Url" ContentType="@ContentType" Alt="@FileName" Text="@_text" />
    }
    @if (_truncated)
    {
        <OxText Variant="OxTextVariant.Small">Preview truncated to the first 1 MiB.</OxText>
    }

    <OxStack Row="true" Justify="OxJustify.Between" Align="OxAlign.Center" Gap="6">
        <OxText Variant="OxTextVariant.Small">@ContentType</OxText>
        <OxStack Row="true" Gap="4">
            <OxButton Icon="download" Href="@(Url + "?download=true")" Download="@FileName" target="_blank">Download</OxButton>
            <OxButton Variant="OxButtonVariant.Primary" OnClick="@(() => DialogService.Close())">Close</OxButton>
        </OxStack>
    </OxStack>
</OxStack>

@code {
    const int MaxTextBytes = 1024 * 1024;

    [Parameter] public string FileName { get; set; } = string.Empty;
    [Parameter] public string ContentType { get; set; } = string.Empty;
    [Parameter] public string Url { get; set; } = string.Empty;
    [Parameter] public string BucketName { get; set; } = string.Empty;
    [Parameter] public string Key { get; set; } = string.Empty;

    [Inject] DialogService DialogService { get; set; } = null!;
    [Inject] IObjectStorageService Storage { get; set; } = null!;

    string _text = string.Empty;
    bool _truncated;

    string MediaType => InlineMediaTypes.MediaType(ContentType);
    bool IsImage => MediaType.StartsWith("image/") && InlineMediaTypes.IsInlineSafe(MediaType);
    bool IsVideo => MediaType.StartsWith("video/");
    bool IsAudio => MediaType.StartsWith("audio/");
    bool IsPdf   => MediaType == "application/pdf";
    bool IsText  => TextPreview.IsTextLike(ContentType);

    OxPreviewKind? Kind =>
        IsImage ? OxPreviewKind.Image
        : IsVideo ? OxPreviewKind.Video
        : IsAudio ? OxPreviewKind.Audio
        : IsPdf ? OxPreviewKind.Pdf
        : IsText ? OxPreviewKind.Text
        : null;

    protected override async Task OnInitializedAsync()
    {
        if (!IsText) return;

        try
        {
            // Read one byte past the cap so a file of exactly MaxTextBytes isn't reported as truncated.
            await using var stream = await Storage.RetrieveAsync(BucketName, Key);
            var buffer = new byte[MaxTextBytes + 1];
            var read = await stream.ReadAtLeastAsync(buffer, buffer.Length, throwOnEndOfStream: false);

            _truncated = read > MaxTextBytes;
            _text = System.Text.Encoding.UTF8.GetString(buffer, 0, Math.Min(read, MaxTextBytes));
            if (!_truncated && TextPreview.IsJson(ContentType))
                _text = TextPreview.PrettyPrintJson(_text);
        }
        catch
        {
            _text = "Preview unavailable.";
        }
    }
}

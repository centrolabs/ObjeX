@using ObjeX.Core.Interfaces
@using ObjeX.Core.Utilities

<div class="preview-container">
    @if (IsImage)
    {
        <img src="@Url" alt="@FileName" style="max-width:100%;max-height:70vh;display:block;margin:0 auto;border-radius:4px" />
    }
    else if (IsVideo)
    {
        <video controls style="max-width:100%;max-height:70vh;display:block;margin:0 auto">
            <source src="@Url" type="@ContentType" />
        </video>
    }
    else if (IsAudio)
    {
        <div style="padding:2rem 0;display:flex;justify-content:center">
            <audio controls style="width:100%">
                <source src="@Url" type="@ContentType" />
            </audio>
        </div>
    }
    else if (IsPdf)
    {
        <iframe src="@(Url + "#pagemode=none&toolbar=0")" style="width:100%;height:70vh;border:none;border-radius:4px" />
    }
    else if (IsText)
    {
        <pre style="width:100%;max-height:70vh;overflow:auto;margin:0;padding:1rem;border-radius:4px;background:var(--rz-base-200);white-space:pre-wrap;word-break:break-word">@_text</pre>
        @if (_truncated)
        {
            <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-text-secondary-color);margin-top:0.5rem">Preview truncated to the first 1 MiB.</RadzenText>
        }
    }
</div>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center" Style="margin-top:1rem">
    <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-text-secondary-color)">@ContentType</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
        <a href="@(Url + "?download=true")" download="@FileName" target="_blank" style="text-decoration:none">
            <RadzenButton Text="Download" Icon="download" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
        </a>
        <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                      Click="@(() => DialogService.Close())" />
    </RadzenStack>
</RadzenStack>

@code {
    const int MaxTextBytes = 1024 * 1024;

    [Parameter] public string FileName { get; set; } = string.Empty;
    [Parameter] public string ContentType { get; set; } = string.Empty;
    [Parameter] public string Url { get; set; } = string.Empty;
    [Parameter] public string BucketName { get; set; } = string.Empty;
    [Parameter] public string Key { get; set; } = string.Empty;

    [Inject] DialogService DialogService { get; set; } = null!;
    [Inject] IObjectStorageService Storage { get; set; } = null!;

    string _text = string.Empty;
    bool _truncated;

    string MediaType => InlineMediaTypes.MediaType(ContentType);
    bool IsImage => MediaType.StartsWith("image/") && InlineMediaTypes.IsInlineSafe(MediaType);
    bool IsVideo => MediaType.StartsWith("video/");
    bool IsAudio => MediaType.StartsWith("audio/");
    bool IsPdf   => MediaType == "application/pdf";
    bool IsText  => TextPreview.IsTextLike(ContentType);

    protected override async Task OnInitializedAsync()
    {
        if (!IsText) return;

        try
        {
            // Read one byte past the cap so a file of exactly MaxTextBytes isn't reported as truncated.
            await using var stream = await Storage.RetrieveAsync(BucketName, Key);
            var buffer = new byte[MaxTextBytes + 1];
            var read = await stream.ReadAtLeastAsync(buffer, buffer.Length, throwOnEndOfStream: false);

            _truncated = read > MaxTextBytes;
            _text = System.Text.Encoding.UTF8.GetString(buffer, 0, Math.Min(read, MaxTextBytes));
            if (!_truncated && TextPreview.IsJson(ContentType))
                _text = TextPreview.PrettyPrintJson(_text);
        }
        catch
        {
            _text = "Preview unavailable.";
        }
    }
}

@inject DialogService DialogService

<OxStack Gap="8">
    <OxField Label="Name" Error="@_error" ReserveError="true">
        <OxTextInput Value="@_name" ValueChanged="OnInput" Placeholder="e.g. my-app, rclone, mc" AutoFocus="true" Invalid="@(_error is not null)"
                     OnEnter="OnEnter" OnEscape="@(() => DialogService.Close(null))" />
    </OxField>
    <OxStack Row="true" Justify="OxJustify.End" Gap="4">
        <OxButton OnClick="@(() => DialogService.Close(null))">Cancel</OxButton>
        <OxButton Variant="OxButtonVariant.Primary" Disabled="@(!IsValid)" OnClick="OnCreate">@SubmitText</OxButton>
    </OxStack>
</OxStack>

@code {
    string _name = string.Empty;
    string? _error;

    public record Result(string Name);

    /// <summary>The current name when the dialog renames a credential.</summary>
    [Parameter] public string? InitialName { get; set; }
    [Parameter] public string SubmitText { get; set; } = "Create";

    protected override void OnInitialized() => _name = InitialName ?? string.Empty;

    bool IsValid => _error is null && !string.IsNullOrWhiteSpace(_name);

    void OnInput(string value)
    {
        _name = value;
        _error = string.IsNullOrWhiteSpace(_name) ? "Name is required." : null;
    }

    void OnEnter()
    {
        if (IsValid) OnCreate();
    }

    void OnCreate() => DialogService.Close(new Result(_name.Trim()));
}

@inject DialogService DialogService
@inject BrowserTimeZone Tz

<OxStack Gap="7" @onkeydown="OnKeyDown" tabindex="-1">
    <OxStack Row="true" Wrap="true" Gap="3">
        @foreach (var preset in _presets)
        {
            var p = preset;
            <OxChip Active="@(_value == p.Value && _unit == p.Unit)" OnClick="@(() => ApplyPreset(p))">@p.Label</OxChip>
        }
    </OxStack>

    <OxStack Row="true" Gap="6" Align="OxAlign.Start">
        <OxStack Grow="true">
            <OxField Label="Duration">
                <OxTextInput Type="number" min="1" Value="@_value.ToString()" ValueChanged="OnValueInput" Invalid="@(_error is not null)" />
            </OxField>
        </OxStack>
        <OxStack Grow="true">
            <OxField Label="Unit">
                <RadzenDropDown @bind-Value="_unit" Data="_units"
                                TextProperty="@nameof(TimeUnit.Label)"
                                ValueProperty="@nameof(TimeUnit.Id)"
                                Change="@(_ => Validate())" />
            </OxField>
        </OxStack>
    </OxStack>

    @if (_error is not null)
    {
        <OxText Variant="OxTextVariant.Small" Tone="OxTone.Danger">@_error</OxText>
    }
    else
    {
        <OxText Variant="OxTextVariant.Small">Expires at: @Tz.FormatSeconds(DateTime.UtcNow.AddSeconds(TotalSeconds))</OxText>
    }

    <OxText Variant="OxTextVariant.Small">Signed with your S3 credential "@CredentialName". The link stops working when you delete that credential.</OxText>

    <OxStack Row="true" Justify="OxJustify.End" Gap="4">
        <OxButton OnClick="@(() => DialogService.Close(null))">Cancel</OxButton>
        <OxButton Variant="OxButtonVariant.Primary" Icon="link" Disabled="@(_error is not null || _value < 1)" OnClick="@(() => DialogService.Close(TotalSeconds))">Copy link</OxButton>
    </OxStack>
</OxStack>

@code {
    [Parameter] public int DefaultSeconds { get; set; } = 3600;
    [Parameter] public int MaxSeconds { get; set; } = 604800;
    [Parameter] public string CredentialName { get; set; } = "";

    int _value = 1;
    string _unit = "hours";
    string? _error;

    record TimeUnit(string Id, string Label, int Multiplier);
    record Preset(string Label, int Value, string Unit);

    static readonly List<TimeUnit> _units =
    [
        new("minutes", "Minutes", 60),
        new("hours",   "Hours",   3600),
        new("days",    "Days",    86400),
    ];

    static readonly List<Preset> _presets =
    [
        new("15 min",  15, "minutes"),
        new("1 h",      1, "hours"),
        new("6 h",      6, "hours"),
        new("24 h",     24, "hours"),
        new("3 d",      3, "days"),
        new("7 d",      7, "days"),
    ];

    int TotalSeconds => _value * (_units.First(u => u.Id == _unit).Multiplier);

    protected override void OnInitialized()
    {
        if (DefaultSeconds % 86400 == 0)      { _value = DefaultSeconds / 86400; _unit = "days"; }
        else if (DefaultSeconds % 3600 == 0)  { _value = DefaultSeconds / 3600;  _unit = "hours"; }
        else                                  { _value = DefaultSeconds / 60;    _unit = "minutes"; }
        Validate();
    }

    void OnValueInput(string value)
    {
        _value = int.TryParse(value, out var v) ? v : 0;
        Validate();
    }

    void ApplyPreset(Preset p)
    {
        _value = p.Value;
        _unit  = p.Unit;
        Validate();
    }

    void Validate()
    {
        if (_value < 1)           { _error = "Duration must be at least 1."; return; }
        if (TotalSeconds > MaxSeconds) { _error = $"Maximum is {MaxSeconds / 86400} days."; return; }
        _error = null;
    }

    void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") DialogService.Close(null);
        if (e.Key == "Enter" && _error is null && _value >= 1)
            DialogService.Close(TotalSeconds);
    }
}

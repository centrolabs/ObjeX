@inject DialogService DialogService

<OxStack Gap="8" @onkeydown="OnKeyDown" tabindex="-1">
    <OxAlert Tone="OxTone.Warning">Share this password securely — it expires in 72 hours.</OxAlert>

    <OxStack Gap="3">
        <OxText Variant="OxTextVariant.Label">Temporary password</OxText>
        <OxCode Text="@Password" Copyable="true" />
    </OxStack>

    <OxStack Row="true" Justify="OxJustify.End">
        <OxButton Variant="OxButtonVariant.Primary" OnClick="@(() => DialogService.Close(null))">Done</OxButton>
    </OxStack>
</OxStack>

@code {
    [Parameter] public string Password { get; set; } = string.Empty;

    void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "Escape") DialogService.Close(null);
    }
}

@inject DialogService DialogService

<OxStack Gap="7">
    @* Picking or dropping hands the files to the page's uploader and closes the dialog; the upload panel shows the rest. *@
    <OxFileDrop Sink="Uploader" FolderLabel="Choose a folder" OnPicked="@(() => DialogService.Close(true))">Drag files or folders here, or click to choose files</OxFileDrop>
    <OxStack Row="true" Justify="OxJustify.End" Gap="4">
        <OxButton OnClick="@(() => DialogService.Close(null))">Cancel</OxButton>
    </OxStack>
</OxStack>

@code {
    /// <summary>The upload script of the Objects page.</summary>
    [Parameter, EditorRequired] public IJSObjectReference? Uploader { get; set; }
}

<OxStack Gap="7">
    <OxPropertyList>
        <OxProperty Label="Key" Mono="true">@Key</OxProperty>
        <OxProperty Label="Content type">@ContentType</OxProperty>
        <OxProperty Label="Size">@FileHelper.FormatBytes(Size) <OxText Variant="OxTextVariant.Small">(@Size.ToString("N0") bytes)</OxText></OxProperty>
        <OxProperty Label="ETag" Mono="true">@ETag</OxProperty>
        <OxProperty Label="Uploaded">@Tz.FormatSeconds(CreatedAt)</OxProperty>
        <OxProperty Label="Last modified">@Tz.FormatSeconds(UpdatedAt)</OxProperty>
    </OxPropertyList>

    @{ var custom = CustomMetadata.Parse(CustomMetadataJson); }
    @if (custom.Count > 0)
    {
        <OxStack Gap="2">
            <OxText Variant="OxTextVariant.Label">Custom metadata</OxText>
            <OxPropertyList>
                @foreach (var entry in custom)
                {
                    <OxProperty Label="@entry.Key" Mono="true">@entry.Value</OxProperty>
                }
            </OxPropertyList>
        </OxStack>
    }

    <OxStack Row="true" Justify="OxJustify.End">
        <OxButton Variant="OxButtonVariant.Primary" OnClick="@(() => DialogService.Close())">Close</OxButton>
    </OxStack>
</OxStack>

@code {
    [Parameter] public string Key         { get; set; } = string.Empty;
    [Parameter] public string ContentType { get; set; } = string.Empty;
    [Parameter] public long   Size        { get; set; }
    [Parameter] public string ETag        { get; set; } = string.Empty;
    [Parameter] public DateTime CreatedAt { get; set; }
    [Parameter] public DateTime UpdatedAt { get; set; }
    [Parameter] public string? CustomMetadataJson { get; set; }

    [Inject] DialogService DialogService { get; set; } = null!;
    [Inject] BrowserTimeZone Tz { get; set; } = null!;
}

@using ObjeX.Core.Interfaces
@inject DialogService DialogService
@inject IJobScheduler Scheduler
@inject BrowserTimeZone Tz

<OxStack Gap="7">
    @if (Job.Warning is { } warning)
    {
        <OxAlert Tone="OxTone.Warning">@warning Saving stores a schedule this server can run.</OxAlert>
    }
    @if (Tz.UnknownId is { } browserZone)
    {
        <OxAlert Tone="OxTone.Warning">This server does not know your browser's time zone @browserZone. Times here are in UTC.</OxAlert>
    }

    <OxSwitch Checked="_enabled" CheckedChanged="@(v => Change(() => _enabled = v))">Enabled</OxSwitch>

    <OxField Label="Frequency">
        <RadzenDropDown TValue="JobFrequency" Value="_draft.Preset.Frequency" Data="Frequencies" TextProperty="Text" ValueProperty="Value"
                        ValueChanged="@((JobFrequency f) => Change(() => _draft.SetFrequency(f)))" />
    </OxField>

    @if (_draft.Preset.Frequency == JobFrequency.Weekly)
    {
        <OxField Label="Day">
            <RadzenDropDown TValue="DayOfWeek" Value="_draft.Preset.Day" Data="Days" TextProperty="Text" ValueProperty="Value"
                            ValueChanged="@((DayOfWeek d) => Change(() => _draft.SetDay(d)))" />
        </OxField>
    }

    @if (_draft.Preset.Frequency == JobFrequency.Custom)
    {
        <OxField Label="Cron (expert)" Error="@_check.Error" Hint="@($"minute hour day-of-month month day-of-week, read in {_draft.CustomZone}")">
            <OxTextInput Mono="true" Value="@_draft.CustomCron" ValueChanged="@(v => Change(() => _draft.SetCron(v)))" />
        </OxField>
    }
    else
    {
        <OxField Label="Time" Error="@_check.Error">
            <OxBox Width="OxWidth.Sm">
                <OxTextInput Type="time" Value="@_draft.Preset.Time.ToString("HH:mm")" ValueChanged="OnTime" />
            </OxBox>
        </OxField>
    }

    <OxText Variant="OxTextVariant.Small">@Preview</OxText>

    @if (Job.Parameter is { } parameter)
    {
        <OxField Label="@($"{parameter.Label} ({parameter.Unit})")" Hint="@($"{parameter.Help} Default {parameter.Default:N0}, {parameter.Min:N0} to {parameter.Max:N0}.")">
            <OxBox Width="OxWidth.Sm">
                <RadzenNumeric TValue="int" Value="_parameter" Min="parameter.Min" Max="parameter.Max"
                               ValueChanged="@((int v) => Change(() => _parameter = v))" />
            </OxBox>
        </OxField>
    }

    <OxStack Row="true" Justify="OxJustify.Between" Gap="4">
        <OxButton Disabled="Job.IsDefault" OnClick="@(() => DialogService.Close(new Result(null)))">Reset to default</OxButton>
        <OxStack Row="true" Gap="4">
            <OxButton OnClick="@(() => DialogService.Close(null))">Cancel</OxButton>
            <OxButton Variant="OxButtonVariant.Primary" Disabled="@(!(_dirty || Job.Warning is not null) || _check.Error is not null)" OnClick="Save">Save</OxButton>
        </OxStack>
    </OxStack>
</OxStack>

@code {
    [Parameter] public RecurringJobStatus Job { get; set; } = null!;

    /// <summary>Change null resets the job to its defaults.</summary>
    public record Result(JobScheduleChange? Change);

    record Option<T>(T Value, string Text);

    static readonly Option<JobFrequency>[] Frequencies =
        [new(JobFrequency.Daily, "Daily"), new(JobFrequency.Weekly, "Weekly"), new(JobFrequency.Custom, "Custom cron")];

    static readonly Option<DayOfWeek>[] Days =
        [.. new[] { 1, 2, 3, 4, 5, 6, 0 }.Select(d => new Option<DayOfWeek>((DayOfWeek)d, ((DayOfWeek)d).ToString()))];

    bool _enabled;
    JobScheduleDraft _draft = null!;
    int _parameter;
    bool _dirty;
    JobScheduleCheck _check = null!;

    // The preset fields are in the browser's zone; a custom cron names its own zone in the field hint.
    string Preview => _check.NextRun is not { } next
        ? $"Times are in {Tz.Zone.Id}."
        : _enabled
            ? $"Next run {Tz.Format(next)}. Times are in {Tz.Zone.Id}."
            : $"Disabled: runs only through Run now. Times are in {Tz.Zone.Id}.";

    protected override void OnInitialized()
    {
        var next = Scheduler.Check(Job.Cron, Job.TimeZone).NextRun;
        _enabled = Job.Enabled;
        _draft = new JobScheduleDraft(Job.Cron, Job.TimeZone, next is { } n ? Tz.ToLocal(n) : null, Tz.Zone.Id);
        _parameter = Job.Parameter is { } p ? p.Value ?? p.Default : 0;
        _check = Scheduler.Check(_draft.Cron, _draft.Zone);
    }

    void Change(Action apply)
    {
        apply();
        _dirty = true;
        _check = Scheduler.Check(_draft.Cron, _draft.Zone);
    }

    void OnTime(string value)
    {
        if (TimeOnly.TryParse(value, out var time))
            Change(() => _draft.SetTime(time));
    }

    void Save() => DialogService.Close(new Result(
        new JobScheduleChange(Job.Id, _enabled, _draft.Cron, _draft.Zone, Job.Parameter is null ? null : _parameter)));
}

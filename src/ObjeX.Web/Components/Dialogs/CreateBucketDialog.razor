@using ObjeX.Core.Validation
@inject DialogService DialogService

<OxStack Gap="8">
    <OxField Label="Bucket name" Hint="3–63 characters, lowercase letters, numbers, hyphens and periods only." Error="@_error">
        <OxTextInput Value="@_name" ValueChanged="OnInput" Placeholder="my-bucket" AutoFocus="true" Invalid="@(_error is not null)"
                     OnEnter="OnEnter" OnEscape="@(() => DialogService.Close(null))" />
    </OxField>
    <OxStack Row="true" Justify="OxJustify.End" Gap="4">
        <OxButton OnClick="@(() => DialogService.Close(null))">Cancel</OxButton>
        <OxButton Variant="OxButtonVariant.Primary" Disabled="@(!IsValid)" OnClick="OnCreate">Create</OxButton>
    </OxStack>
</OxStack>

@code {
    string _name = string.Empty;
    string? _error;

    bool IsValid => _error is null && !string.IsNullOrWhiteSpace(_name);

    void OnInput(string value)
    {
        _name = value;
        _error = string.IsNullOrWhiteSpace(_name) ? null : BucketNameValidator.GetValidationError(_name);
    }

    void OnCreate() => DialogService.Close(_name.Trim());

    void OnEnter()
    {
        if (IsValid) OnCreate();
    }
}

@inject DialogService DialogService

<OxStack Gap="8" @onkeydown="OnKeyDown" tabindex="-1">
    <S3ConnectSnippets Endpoint="@Endpoint" AccessKeyId="@AccessKeyId" />

    <OxStack Row="true" Justify="OxJustify.End">
        <OxButton Variant="OxButtonVariant.Primary" OnClick="@(() => DialogService.Close(null))">Done</OxButton>
    </OxStack>
</OxStack>

@code {
    [Parameter] public string AccessKeyId { get; set; } = string.Empty;
    [Parameter] public string Endpoint { get; set; } = string.Empty;

    void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") DialogService.Close(null);
    }
}
